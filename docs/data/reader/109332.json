tant","Formalism.MainNotions.FamClass"],[9,55,9,61,"UpperTheory.Top.FReq","Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.ConjEMemHostFIff","Formalism.HC.HostAx"],[42,23,42,32,"UpperTheory.Top.GChi","Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.ConjEMemHostFIff","Formalism.HC.HostAx.toHostRaw"],[42,57,42,58,"UpperTheory.Top.GChi","Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.ConjEMemHostFIff","Formalism.HC.HostRaw.E"],[42,2,42,6,"UpperTheory.Top.GChi","Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.ExplicitFormulaErrorOfHostConditions","Formalism.HC.EAtH"],[42,8,42,17,"UpperTheory.Top.GChi","Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.ExplicitFormulaErrorOfHostConditions","Formalism.HC.Level.cyc"],[41,14,41,19,"UpperTheory.Top.GChi","Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.PrimePairSizeCondition","Formalism.HC.PChar"],[9,43,9,48,"UpperTheory.Top.FReq","Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.ZsmulGeneratorEqZeroOfProjection","Formalism.HC.Frame"],[9,79,9,80,"UpperTheory.Top.FReq","Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.ZsmulGeneratorEqZeroOfProjection","Formalism.HC.Frame.A"],[24,73,24,74,"UpperTheory.Top.FReq.at_of_from","Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.ZsmulGeneratorEqZeroOfProjection","Formalism.HC.Frame.A"],[30,58,30,92,"UpperTheory.Top.FReq.at_of_from","Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.ZsmulGeneratorEqZeroOfProjection","Formalism.HC.Frame.A.val_injective"],[24,77,24,78,"UpperTheory.Top.FReq.at_of_from","Init.Data.Int.Basic","Int"],[26,15,26,16,"UpperTheory.Top.FReq.at_of_from","Init.Prelude","And.left"],[28,17,28,18,"UpperTheory.Top.FReq.at_of_from","Init.Prelude","And.left"],[28,15,28,16,"UpperTheory.Top.FReq.at_of_from","Init.Prelude","And.right"],[24,117,24,121,"UpperTheory.Top.FReq.at_of_from","Init.Prelude","Bool"],[24,93,24,96,"UpperTheory.Top.FReq.at_of_from","Init.Prelude","Fin"],[24,101,24,104,"UpperTheory.Top.FReq.at_of_from","Init.Prelude","Fin"],[9,87,9,88,"UpperTheory.Top.FReq","Init.Prelude","Nat"],[24,85,24,86,"UpperTheory.Top.FReq.at_of_from","Init.Prelude","Nat"],[25,10,25,11,"UpperTheory.Top.FReq.at_of_from","Init.Prelude","Nat"],[32,6,32,15,"UpperTheory.Top.FReq.at_of_from","Init.Prelude","eq_of_heq"],[42,62,42,71,"UpperTheory.Top.GChi","Mathlib.Analysis.Real.Sqrt","Real.sqrt"],[9,70,9,76,"UpperTheory.Top.FReq","Mathlib.Data.Finset.Defs","Finset"],[30,34,30,56,"UpperTheory.Top.FReq.at_of_from","Mathlib.Data.Finset.Image","Finset.image_injective"],[21,14,21,15,"UpperTheory.Top.FReq.cls","Mathlib.Data.Real.Basic","Real"],[37,30,37,31,"UpperTheory.Top.ExD","Mathlib.Data.Real.Basic","Real"],[37,34,37,35,"UpperTheory.Top.ExD","Mathlib.Data.Real.Basic","Real"],[37,38,37,39,"UpperTheory.Top.ExD","Mathlib.Data.Real.Basic","Real"],[38,10,38,11,"UpperTheory.Top.ExD","Mathlib.Data.Real.Basic","Real"]],"source":"import Development.AbelianVarietyTheory.Definitions.GlobalTwisting.AuxiliaryPrimeMemAvoidedPrimes\nimport Development.AutomorphicArithmetic.CharacterBoxes.TwistForm\n\nnoncomputable section\n\nnamespace UpperTheory.Top\n\nopen Formalism.BasicNotions Formalism.MainNotions Formalism.MainNotions.Inhab Formalism.HC GlobalTheory.EX\n\nabbrev FReq : Type 1 := ∀ (_ : Scale) (φ : Frame) (_ : HostAx φ) (_ : Finset φ.A) (_ : ℕ), Prop\n\nnamespace FReq\n\nvariable (G : FReq)\n\ndef req : HostReq := fun _ s R H _ => G s R.toFrame H.toHostAx H.TT R.t\n\ndef At {D : D7} (L : SizeData₂ D) : Prop := G L.sc D.R.toFrame D.host.toHostAx D.host.TT D.R.t\n\ndef pt : PtProp := fun _ L _ _ _ _ _ _ _ => G.At L\n\ndef cls (la : ℝ) : FamClass := fun Fm =>\n  Fm.toFamCore.Windows la ∧ ∀ x, Fm.x1 < x → ∀ i : Fm.Ix x, G.At (Fm.L x i)\n\ntheorem at_of_from {C : FC} {p : Pt C} {R : Ranks} {H : Host R} {a b : R.A → ℤ} {M : ℕ} {c : Fin M → Fin (R.k - 2) → Bool}\n    {u0 : ℕ} (h : p.From H a b c u0) (hG : G p.L.sc R.toFrame H.toHostAx H.TT R.t) : G.At p.L := by\n  have h1 := h.1\n  have h2 := h.field\n  have h3 := h.2.1\n  subst h1\n  have h4 : p.D.host.TT = H.TT := Finset.image_injective (Formalism.HC.Frame.A.val_injective _) h3\n  unfold At\n  rw [eq_of_heq h2, h4]\n  exact hG\n\nend FReq\n\ndef ExD (𝒜 : FamClass) (cT : ℝ → ℝ → ℝ) : Prop :=\n  ∀ (la : ℝ) (G : FReq), 1 < la → HostExW la G.req →\n    DC.DesignChoices (DC.WithTw fun Fm => 𝒜 Fm ∧ G.cls la Fm) 3 cT\n\ndef GChi (ψ : PChar) : FReq := fun s _ H TT t =>\n  EAtH (Level.cyc ψ) H.toHostRaw TT s.x s.eps 4 ∧ VVle H.E t (Real.sqrt s.b)\n\nend UpperTheory.Top\n\nend\n","kernel":true}