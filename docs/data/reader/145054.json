unctions.Gamma.Deligne","Complex.Gammaℝ_ne_zero_of_re_pos"],[8,34,8,58,"Formalism.VW.gammaFactor_ne_zero","Mathlib.Analysis.SpecialFunctions.Gamma.Deligne","Complex.Gammaℝ_ne_zero_of_re_pos"],[5,73,5,74,"Formalism.VW.gammaFactor_ne_zero","Mathlib.Data.Complex.Basic","Complex"],[5,83,5,84,"Formalism.VW.gammaFactor_ne_zero","Mathlib.Data.Complex.Basic","Complex"],[10,106,10,107,"Formalism.VW.critLine","Mathlib.Data.Complex.Basic","Complex"],[10,137,10,138,"Formalism.VW.critLine","Mathlib.Data.Complex.Basic","Complex"],[30,40,30,41,"Formalism.VW.rh_of_every","Mathlib.Data.Complex.Basic","Complex"],[8,67,8,73,"Formalism.VW.gammaFactor_ne_zero","Mathlib.Data.Complex.Basic","Complex.add_re"],[8,75,8,81,"Formalism.VW.gammaFactor_ne_zero","Mathlib.Data.Complex.Basic","Complex.one_re"],[24,43,24,49,"Formalism.VW.critLine","Mathlib.Data.Complex.Basic","Complex.one_re"],[5,98,5,100,"Formalism.VW.gammaFactor_ne_zero","Mathlib.Data.Complex.Basic","Complex.re"],[11,16,11,18,"Formalism.VW.critLine","Mathlib.Data.Complex.Basic","Complex.re"],[11,28,11,30,"Formalism.VW.critLine","Mathlib.Data.Complex.Basic","Complex.re"],[11,65,11,67,"Formalism.VW.critLine","Mathlib.Data.Complex.Basic","Complex.re"],[24,35,24,41,"Formalism.VW.critLine","Mathlib.Data.Complex.Basic","Complex.sub_re"],[5,54,5,72,"Formalism.VW.gammaFactor_ne_zero","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter"],[10,87,10,105,"Formalism.VW.critLine","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter"],[30,21,30,39,"Formalism.VW.rh_of_every","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter"],[10,119,10,130,"Formalism.VW.critLine","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.IsPrimitive"],[16,20,16,31,"Formalism.VW.critLine","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.IsPrimitive"],[17,27,17,40,"Formalism.VW.critLine","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.conductor_inv"],[6,11,6,22,"Formalism.VW.gammaFactor_ne_zero","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.even_or_odd"],[17,10,17,25,"Formalism.VW.critLine","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.isPrimitive_def"],[7,10,7,25,"Formalism.VW.gammaFactor_ne_zero","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.Even.gammaFactor_def"],[21,21,21,47,"Formalism.VW.critLine","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.IsPrimitive.completedLFunction_one_sub"],[11,42,11,51,"Formalism.VW.critLine","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction"],[19,10,19,48,"Formalism.VW.critLine","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction_eq_completed_div_gammaFactor"],[25,8,25,46,"Formalism.VW.critLine","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction_eq_completed_div_gammaFactor"],[31,9,31,28,"Formalism.VW.rh_of_every","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction_modOne_eq"],[8,10,8,25,"Formalism.VW.gammaFactor_ne_zero","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.Odd.gammaFactor_def"],[18,14,18,32,"Formalism.VW.critLine","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.completedLFunction"],[5,104,5,115,"Formalism.VW.gammaFactor_ne_zero","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.gammaFactor"],[28,68,28,85,"Formalism.VW.rh_of_every","Mathlib.NumberTheory.LSeries.RiemannZeta","RiemannHypothesis"],[15,9,15,23,"Formalism.VW.critLine","Mathlib.Order.Defs.LinearOrder","lt_or_gt_of_ne"]],"source":"import Development.AutomorphicArithmetic.CharacterBoxes.EveryCharacter\nimport Formalism.GammaFactorNonvanishing.RhOfRight\n\nopen Complex DirichletCharacter\n\ntheorem Formalism.VW.gammaFactor_ne_zero {N : ℕ} (χ : DirichletCharacter ℂ N) {s : ℂ} (hs : 0 < s.re) : gammaFactor χ s ≠ 0 := by\n  rcases χ.even_or_odd with h | h\n  · rw [h.gammaFactor_def]; exact Gammaℝ_ne_zero_of_re_pos hs\n  · rw [h.gammaFactor_def]; exact Gammaℝ_ne_zero_of_re_pos (by rw [add_re, one_re]; linarith)\n\ntheorem Formalism.VW.critLine (h : UpperTheory.EveryCharacter) (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N) (hχ : χ.IsPrimitive) (s : ℂ)\n    (h0 : 0 < s.re) (h1 : s.re < 1) (hz : LFunction χ s = 0) : s.re = 1 / 2 := by\n  have hs0 : s ≠ 0 := fun e => by simp [e] at h0\n  have hs1 : s ≠ 1 := fun e => by simp [e] at h1\n  by_contra hne\n  rcases lt_or_gt_of_ne hne with hlt | hgt\n  · have hinv : χ⁻¹.IsPrimitive := by\n      rw [isPrimitive_def, conductor_inv]; exact hχ\n    have hc : completedLFunction χ s = 0 := by\n      rw [LFunction_eq_completed_div_gammaFactor χ s (Or.inl hs0)] at hz\n      exact (div_eq_zero_iff.1 hz).resolve_right (Formalism.VW.gammaFactor_ne_zero χ h0)\n    have hfe := hinv.completedLFunction_one_sub s\n    rw [inv_inv, hc, mul_zero] at hfe\n    have h2 : (1 - s) ≠ 0 := sub_ne_zero.2 hs1.symm\n    refine h N χ⁻¹ (1 - s) (by rw [sub_re, one_re]; linarith) (Or.inr fun e => hs0 (by linear_combination -e)) ?_\n    rw [LFunction_eq_completed_div_gammaFactor χ⁻¹ (1 - s) (Or.inl h2), hfe, zero_div]\n  · exact h N χ s hgt (Or.inr hs1) hz\n\ntheorem Formalism.VW.rh_of_every (h : UpperTheory.EveryCharacter) : RiemannHypothesis :=\n  Formalism.VW.rh_of_right fun s hs hs1 => by\n    have := h 1 (1 : DirichletCharacter ℂ 1) s hs (Or.inr hs1)\n    rwa [LFunction_modOne_eq] at this\n","kernel":true}