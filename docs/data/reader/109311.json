],[58,8,58,33,"UpperTheory.Top.VVle.mono","Mathlib.Algebra.Order.GroupWithZero.Defs","mul_le_mul_of_nonneg_left"],[41,94,41,102,"UpperTheory.Top.VAt","Mathlib.Analysis.Complex.Exponential","Real.exp"],[41,83,41,92,"UpperTheory.Top.VAt","Mathlib.Analysis.Real.Sqrt","Real.sqrt"],[15,15,15,23,"UpperTheory.Top.VVle","Mathlib.Analysis.SpecialFunctions.Log.Basic","Real.log"],[29,29,29,37,"UpperTheory.Top.WinPair","Mathlib.Analysis.SpecialFunctions.Log.Basic","Real.log"],[30,9,30,17,"UpperTheory.Top.WinPair","Mathlib.Analysis.SpecialFunctions.Log.Basic","Real.log"],[33,25,33,33,"UpperTheory.Top.WinPair","Mathlib.Analysis.SpecialFunctions.Log.Basic","Real.log"],[33,46,33,54,"UpperTheory.Top.WinPair","Mathlib.Analysis.SpecialFunctions.Log.Basic","Real.log"],[34,9,34,17,"UpperTheory.Top.WinPair","Mathlib.Analysis.SpecialFunctions.Log.Basic","Real.log"],[34,38,34,46,"UpperTheory.Top.WinPair","Mathlib.Analysis.SpecialFunctions.Log.Basic","Real.log"],[58,37,58,60,"UpperTheory.Top.VVle.mono","Mathlib.Analysis.SpecialFunctions.Log.Basic","Real.log_natCast_nonneg"],[70,47,70,63,"UpperTheory.Top.exists_pageN","Mathlib.Analysis.SpecialFunctions.Pow.Real","Real.one_le_rpow"],[16,112,16,117,"UpperTheory.Top.VVle","Mathlib.Data.ENat.Basic","ENat.toNat"],[14,10,14,16,"UpperTheory.Top.VVle","Mathlib.Data.Finset.Defs","Finset"],[12,82,12,87,"UpperTheory.Top.VVle","Mathlib.Data.Nat.Prime.Defs","Nat.Prime"],[13,23,13,28,"UpperTheory.Top.VVle","Mathlib.Data.Nat.Prime.Defs","Nat.Prime"],[27,14,27,19,"UpperTheory.Top.WinPair","Mathlib.Data.Nat.Prime.Defs","Nat.Prime"],[31,14,31,19,"UpperTheory.Top.WinPair","Mathlib.Data.Nat.Prime.Defs","Nat.Prime"],[36,23,36,28,"UpperTheory.Top.WinPair","Mathlib.Data.Nat.Prime.Defs","Nat.Prime"],[14,17,14,27,"UpperTheory.Top.VVle","Mathlib.Data.Nat.Prime.Defs","Nat.Primes"],[11,59,11,60,"UpperTheory.Top.VVle","Mathlib.Data.Real.Basic","Real"],[16,120,16,121,"UpperTheory.Top.VVle","Mathlib.Data.Real.Basic","Real"],[26,27,26,28,"UpperTheory.Top.WinPair","Mathlib.