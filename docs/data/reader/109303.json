er.conductor_inv"],[65,37,65,54,"Claim.strip","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.conductor_ne_zero"],[36,11,36,22,"Claim.gamma_ne_zero","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.even_or_odd"],[52,8,52,42,"Claim.prim_reflect","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.isPrimitive_def"],[24,35,24,53,"Claim.prim_zero","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.primitiveCharacter"],[27,6,27,24,"Claim.prim_zero","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.primitiveCharacter"],[67,30,67,48,"Claim.strip","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.primitiveCharacter"],[69,26,69,44,"Claim.strip","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.primitiveCharacter"],[67,51,67,81,"Claim.strip","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.primitiveCharacter_isPrimitive"],[17,26,17,37,"Claim.factor_ne_zero","Mathlib.NumberTheory.DirichletCharacter.Bounds","DirichletCharacter.norm_le_one"],[37,11,37,26,"Claim.gamma_ne_zero","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.Even.gammaFactor_def"],[53,17,53,43,"Claim.prim_reflect","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.IsPrimitive.completedLFunction_one_sub"],[23,43,23,71,"Claim.prim_zero","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction"],[24,4,24,32,"Claim.prim_zero","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction"],[42,43,42,71,"Claim.prim_reflect","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction"],[43,4,43,32,"Claim.prim_reflect","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction"],[79,16,79,44,"Claim.zeta","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction"],[26,14,26,54,"Claim.prim_zero","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction_changeLevel"],[48,8,48,65,"Claim.prim_reflect","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction_eq_completed_div_gammaFactor"],[55,6,55,63,"Claim.prim_reflect","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction_eq_completed_div_gammaFactor"],[80,12,80,50,"Claim.zeta","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction_modOne_eq"],[38,11,38,26,"Claim.gamma_ne_zero","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.Odd.gammaFactor_def"],[47,12,47,49,"Claim.prim_reflect","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.completedLFunction"],[35,4,35,34,"Claim.gamma_ne_zero","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.gammaFactor"],[82,23,82,55,"Claim.zeta","Mathlib.NumberTheory.LSeries.Nonvanishing","riemannZeta_ne_zero_of_one_le_re"],[99,10,99,42,"Claim.zeta","Mathlib.NumberTheory.LSeries.Nonvanishing","riemannZeta_ne_zero_of_one_le_re"],[101,26,101,43,"Claim.zeta_iff","Mathlib.NumberTheory.LSeries.RiemannZeta","RiemannHypothesis"],[90,14,90,34,"Claim.zeta","Mathlib.NumberTheory.LSeries.RiemannZeta","completedRiemannZeta"],[98,42,98,70,"Claim.zeta","Mathlib.NumberTheory.LSeries.RiemannZeta","completedRiemannZeta_one_sub"],[97,15,97,26,"Claim.zeta","Mathlib.NumberTheory.LSeries.RiemannZeta","riemannZeta"],[91,10,91,36,"Claim.zeta","Mathlib.NumberTheory.LSeries.RiemannZeta","riemannZeta_def_of_ne_zero"],[98,10,98,36,"Claim.zeta","Mathlib.NumberTheory.LSeries.RiemannZeta","riemannZeta_def_of_ne_zero"],[76,41,76,57,"Claim.zeta","Mathlib.NumberTheory.LSeries.RiemannZeta","riemannZeta_zero"],[77,9,77,17,"Claim.zeta","Mathlib.Order.Defs.LinearOrder","lt_or_ge"],[78,11,78,19,"Claim.zeta","Mathlib.Order.Defs.LinearOrder","lt_or_ge"],[63,9,63,22,"Claim.strip","Mathlib.Order.Defs.LinearOrder","lt_trichotomy"],[20,8,20,17,"Claim.factor_ne_zero","Mathlib.Order.Defs.PartialOrder","lt_irrefl"],[25,70,25,79,"Claim.prim_zero","Mathlib.Order.Defs.PartialOrder","lt_irrefl"],[44,73,44,82,"Claim.prim_reflect","Mathlib.Order.Defs.PartialOrder","lt_irrefl"],[46,77,46,86,"Claim.prim_reflect","Mathlib.Order.Defs.PartialOrder","lt_irrefl"],[61,70,61,79,"Claim.strip","Mathlib.Order.Defs.PartialOrder","lt_irrefl"],[62,73,62,82,"Claim.strip","Mathlib.Order.Defs.PartialOrder","lt_irrefl"]],"source":"import Development.AutomorphicArithmetic.CharacterBoxes.HalfPlane\n\nopen Complex\n\nnamespace Claim\n\ntheorem factor_ne_zero {M : ℕ} (ψ : DirichletCharacter ℂ M) {s : ℂ} (hs : 0 < s.re) (p : ℕ)\n    (hp : p.Prime) : (1 : ℂ) - ψ p * (p : ℂ) ^ (-s) ≠ 0 := by\n  intro h\n  have h1 : ψ p * (p : ℂ) ^ (-s) = 1 := by linear_combination -h\n  have hp1 : (1 : ℝ) < p := by exact_mod_cast hp.one_lt\n  have hpow : ‖(p : ℂ) ^ (-s)‖ < 1 := by\n    rw [Complex.norm_natCast_cpow_of_pos hp.pos, Complex.neg_re]\n    exact Real.rpow_lt_one_of_one_lt_of_neg hp1 (by linarith)\n  have hn : ‖ψ p * (p : ℂ) ^ (-s)‖ < 1 := by\n    rw [norm_mul]\n    calc ‖ψ p‖ * ‖(p : ℂ) ^ (-s)‖ ≤ 1 * ‖(p : ℂ) ^ (-s)‖ := by\n          gcongr; exact ψ.norm_le_one _\n      _ < 1 := by rw [one_mul]; exact hpow\n  rw [h1, norm_one] at hn\n  exact lt_irrefl _ hn\n\ntheorem prim_zero {N : ℕ} [NeZero N] (χ : DirichletCharacter ℂ N) [NeZero χ.conductor] {s : ℂ}\n    (hs0 : 0 < s.re) (hs1 : s.re < 1) (h : DirichletCharacter.LFunction χ s = 0) :\n    DirichletCharacter.LFunction χ.primitiveCharacter s = 0 := by\n  have hs : s ≠ 1 := fun e => by rw [e, Complex.one_re] at hs1; exact lt_irrefl _ hs1\n  have key := DirichletCharacter.LFunction_changeLevel χ.conductor_dvd_level\n    χ.primitiveCharacter (Or.inr hs)\n  rw [χ.changeLevel_primitiveCharacter, h] at key\n  rcases mul_eq_zero.mp key.symm with h' | h'\n  · exact h'\n  · obtain ⟨p, hp, hp0⟩ := Finset.prod_eq_zero_iff.mp h'\n    exact absurd hp0 (factor_ne_zero _ hs0 p (Nat.prime_of_mem_primeFactors hp))\n\ntheorem gamma_ne_zero {M : ℕ} [NeZero M] (φ : DirichletCharacter ℂ M) {t : ℂ} (ht : 0 < t.re) :\n    DirichletCharacter.gammaFactor φ t ≠ 0 := by\n  rcases φ.even_or_odd with hφ | hφ\n  · rw [hφ.gammaFactor_def]; exact Complex.Gammaℝ_ne_zero_of_re_pos ht\n  · rw [hφ.gammaFactor_def]\n    exact Complex.Gammaℝ_ne_zero_of_re_pos (by rw [Complex.add_re, Complex.one_re]; linarith)\n\ntheorem prim_reflect {M : ℕ} [NeZero M] (ψ : DirichletCharacter ℂ M) (hψ : ψ.IsPrimitive) {s : ℂ}\n    (hs0 : 0 < s.re) (hs1 : s.re < 1) (h : DirichletCharacter.LFunction ψ s = 0) :\n    DirichletCharacter.LFunction ψ⁻¹ (1 - s) = 0 := by\n  have hs0' : s ≠ 0 := fun e => by rw [e, Complex.zero_re] at hs0; exact lt_irrefl _ hs0\n  have ht0 : 0 < (1 - s).re := by rw [Complex.sub_re, Complex.one_re]; linarith\n  have ht0' : 1 - s ≠ 0 := fun e => by rw [e, Complex.zero_re] at ht0; exact lt_irrefl _ ht0\n  have hc : DirichletCharacter.completedLFunction ψ s = 0 := by\n    rw [DirichletCharacter.LFunction_eq_completed_div_gammaFactor ψ s (Or.inl hs0'),\n      div_eq_zero_iff] at h\n    exact h.resolve_right (gamma_ne_zero ψ hs0)\n  have hψ' : (ψ⁻¹).IsPrimitive := by\n    rw [DirichletCharacter.isPrimitive_def, DirichletCharacter.conductor_inv]; exact hψ\n  have fe := hψ'.completedLFunction_one_sub s\n  rw [inv_inv, hc, mul_zero] at fe\n  rw [DirichletCharacter.LFunction_eq_completed_div_gammaFactor ψ⁻¹ (1 - s) (Or.inl ht0'), fe,\n    zero_div]\n\ntheorem strip (h : HalfPlane) : Strip := by\n  unfold HalfPlane at h\n  intro N _ χ s hs0 hs1 hz\n  have hs : s ≠ 1 := fun e => by rw [e, Complex.one_re] at hs1; exact lt_irrefl _ hs1\n  have hs0' : s ≠ 0 := fun e => by rw [e, Complex.zero_re] at hs0; exact lt_irrefl _ hs0\n  rcases lt_trichotomy s.re (1 / 2) with hlt | heq | hgt\n  · exfalso\n    haveI : NeZero χ.conductor := ⟨χ.conductor_ne_zero⟩\n    have hp := prim_zero χ hs0 hs1 hz\n    have hr := prim_reflect χ.primitiveCharacter χ.primitiveCharacter_isPrimitive hs0 hs1 hp\n    have ht : (1 : ℂ) - s ≠ 1 := fun e => hs0' (sub_eq_self.mp e)\n    exact h χ.conductor χ.primitiveCharacter⁻¹ (1 - s)\n      (by rw [Complex.sub_re, Complex.one_re]; linarith) (Or.inr ht) hr\n  · exact heq\n  · exact absurd hz (h N χ s hgt (Or.inr hs))\n\ntheorem zeta (h : HalfPlane) : Zeta := by\n  intro s hz htriv hs1\n  have hs0 : s ≠ 0 := fun e => by rw [e, riemannZeta_zero] at hz; norm_num at hz\n  rcases lt_or_ge 0 s.re with hpos | hnpos\n  · rcases lt_or_ge s.re 1 with hlt1 | hge1\n    · have hL : DirichletCharacter.LFunction (1 : DirichletCharacter ℂ 1) s = 0 := by\n        rw [DirichletCharacter.LFunction_modOne_eq]; exact hz\n      exact strip h 1 1 s hpos hlt1 hL\n    · exact absurd hz (riemannZeta_ne_zero_of_one_le_re hge1)\n  · exfalso\n    have hG : Gammaℝ s ≠ 0 := by\n      intro hg\n      obtain ⟨n, hn⟩ := Complex.Gammaℝ_eq_zero_iff.mp hg\n      rcases n with _ | n\n      · exact hs0 (by simpa using hn)\n      · exact htriv ⟨n, by rw [hn]; push_cast; ring⟩\n    have hc : completedRiemannZeta s = 0 := by\n      rw [riemannZeta_def_of_ne_zero hs0, div_eq_zero_iff] at hz\n      exact hz.resolve_right hG\n    have h1s : 1 - s ≠ 0 := fun e => by\n      have := congrArg Complex.re e\n      rw [Complex.sub_re, Complex.one_re, Complex.zero_re] at this\n      linarith\n    have hz' : riemannZeta (1 - s) = 0 := by\n      rw [riemannZeta_def_of_ne_zero h1s, completedRiemannZeta_one_sub, hc, zero_div]\n    exact riemannZeta_ne_zero_of_one_le_re (by rw [Complex.sub_re, Complex.one_re]; linarith) hz'\n\ntheorem zeta_iff : Zeta ↔ RiemannHypothesis := Iff.rfl\n\nend Claim\n","kernel":true}