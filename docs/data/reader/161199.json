e","Mathlib.Data.Real.Basic","Real"],[16,46,16,47,"Formalism.HC.hasWindows_of_large","Mathlib.Data.Real.Basic","Real"],[16,77,16,78,"Formalism.HC.hasWindows_of_large","Mathlib.Data.Real.Basic","Real"],[23,22,23,23,"Formalism.HC.Level.LandauWinAt","Mathlib.Data.Real.Basic","Real"],[24,8,24,9,"Formalism.HC.Level.LandauWinAt","Mathlib.Data.Real.Basic","Real"],[25,11,25,12,"Formalism.HC.Level.LandauWinAt","Mathlib.Data.Real.Basic","Real"],[25,30,25,31,"Formalism.HC.Level.LandauWinAt","Mathlib.Data.Real.Basic","Real"],[27,31,27,32,"Formalism.HC.Level.LandauWin","Mathlib.Data.Real.Basic","Real"],[29,18,29,19,"Formalism.HC.Level.FormBAt","Mathlib.Data.Real.Basic","Real"],[30,8,30,9,"Formalism.HC.Level.FormBAt","Mathlib.Data.Real.Basic","Real"],[32,27,32,28,"Formalism.HC.Level.FormB","Mathlib.Data.Real.Basic","Real"],[36,31,36,32,"Formalism.HC.Level.FormBAt.mono","Mathlib.Data.Real.Basic","Real"],[6,20,6,23,"Formalism.HC.HasWindows","Mathlib.Data.Set.Defs","Set"],[9,32,9,35,"Formalism.HC.HasWindows.mono","Mathlib.Data.Set.Defs","Set"],[16,33,16,36,"Formalism.HC.hasWindows_of_large","Mathlib.Data.Set.Defs","Set"],[24,62,24,90,"Formalism.HC.Level.LandauWinAt","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction"],[13,30,13,35,"Formalism.HC.HasWindows.mono","Mathlib.Order.Basic","LE.le.trans"],[14,44,14,49,"Formalism.HC.HasWindows.mono","Mathlib.Order.Basic","LE.le.trans"],[14,55,14,60,"Formalism.HC.HasWindows.mono","Mathlib.Order.Basic","LE.le.trans"],[17,77,17,82,"Formalism.HC.hasWindows_of_large","Mathlib.Order.Basic","LE.le.trans"],[42,31,42,36,"Formalism.HC.Level.FormBAt.mono","Mathlib.Order.Basic","LE.le.trans"],[42,73,42,78,"Formalism.HC.Level.FormBAt.mono","Mathlib.Order.Basic","LE.le.trans"],[43,61,43,66,"Formalism.HC.Level.FormBAt.mono","Mathlib.Order.Basic","LE.le.trans"],[13,13,13,24,"Formalism.HC.HasWindows.mono","Mathlib.Order.Defs.LinearOrder","le_max_left"],[17,22,17,33,"Formalism.HC.hasWindows_of_large","Mathlib.Order.Defs.LinearOrder","le_max_left"],[42,14,42,25,"Formalism.HC.Level.FormBAt.mono","Mathlib.Order.Defs.LinearOrder","le_max_left"],[14,26,14,38,"Formalism.HC.HasWindows.mono","Mathlib.Order.Defs.LinearOrder","le_max_right"],[17,59,17,71,"Formalism.HC.hasWindows_of_large","Mathlib.Order.Defs.LinearOrder","le_max_right"],[43,43,43,55,"Formalism.HC.Level.FormBAt.mono","Mathlib.Order.Defs.LinearOrder","le_max_right"]],"source":"import Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.ExplicitFormulaErrorOfHostConditions\n\nnoncomputable section\n\nnamespace Formalism.HC\n\ndef HasWindows (S : Set ℝ) (la : ℝ) : Prop :=\n  ∀ y : ℝ, ∃ Y : ℝ, y ≤ Y ∧ ∀ x : ℝ, Y ≤ x → x ≤ Y ^ la → x ∈ S\n\ntheorem HasWindows.mono {S S' : Set ℝ} {la x0 : ℝ} (h : HasWindows S la) (hS : ∀ x ≥ x0, x ∈ S → x ∈ S') :\n    HasWindows S' la := by\n  intro y\n  obtain ⟨Y, hyY, hY⟩ := h (max y x0)\n  exact ⟨Y, (le_max_left _ _).trans hyY,\n    fun x h1 h2 => hS x ((le_max_right _ _).trans (hyY.trans h1)) (hY x h1 h2)⟩\n\ntheorem hasWindows_of_large {S : Set ℝ} {x0 : ℝ} (h : ∀ x ≥ x0, x ∈ S) (la : ℝ) : HasWindows S la :=\n  fun y => ⟨max y x0, le_max_left _ _, fun x h1 _ => h x ((le_max_right _ _).trans h1)⟩\n\nnamespace Level\n\nvariable (Λ : Level)\n\ndef LandauWinAt (la : ℝ) : Prop :=\n  ∀ θ : ℝ, 0 < θ → θ < 1 → (∃ ψ ∈ Λ.KEPT, ∃ s : ℂ, θ < s.re ∧ DirichletCharacter.LFunction ψ.χ s = 0) →\n    ∃ Y0 : ℝ, ∀ Y ≥ Y0, ∃ y : ℝ, Y ≤ y ∧ y ≤ Y ^ la ∧ y ^ θ < Λ.Gm y\n\ndef LandauWin : Prop := ∀ la : ℝ, 1 < la → Λ.LandauWinAt la\n\ndef FormBAt (la : ℝ) : Prop :=\n  ∀ θ : ℝ, 0 < θ → θ < 1 → HasWindows {x | Λ.Gm x ≤ x ^ θ} la → Λ.ZeroFreeAbove θ\n\ndef FormB : Prop := ∀ la : ℝ, 1 < la → Λ.FormBAt la\n\nvariable {Λ}\n\ntheorem FormBAt.mono {la la' : ℝ} (h : Λ.FormBAt la) (hl : la ≤ la') : Λ.FormBAt la' := by\n  unfold FormBAt at h ⊢\n  intro θ h0 h1 hw\n  apply h θ h0 h1\n  intro y\n  obtain ⟨Y, hyY, hY⟩ := hw (max y 1)\n  refine ⟨Y, (le_max_left _ _).trans hyY, fun x hx1 hx2 => hY x hx1 (hx2.trans ?_)⟩\n  exact Real.rpow_le_rpow_of_exponent_le ((le_max_right _ _).trans hyY) hl\n\nend Level\n\nend Formalism.HC\n\nend\n","kernel":true}