tGaloisClasses.PrimePairSizeCondition","Formalism.HC.PChar.one"],[21,17,21,21,"_private.Development.AutomorphicArithmetic.PrimitiveCosets.LevelFamily.0.UpperTheory.Comparison₂.level_family_adm","Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.PrimePairSizeCondition","Formalism.HC.PChar.prim"],[18,83,18,84,"_private.Development.AutomorphicArithmetic.PrimitiveCosets.LevelFamily.0.UpperTheory.Comparison₂.level_family_adm","Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.PrimePairSizeCondition","Formalism.HC.PChar.χ"],[19,17,19,18,"_private.Development.AutomorphicArithmetic.PrimitiveCosets.LevelFamily.0.UpperTheory.Comparison₂.level_family_adm","Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.PrimePairSizeCondition","Formalism.HC.PChar.χ"],[27,82,27,83,"_private.Development.AutomorphicArithmetic.PrimitiveCosets.LevelFamily.0.UpperTheory.Comparison₂.level_family_sum","Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.PrimePairSizeCondition","Formalism.HC.PChar.χ"],[43,93,43,94,"UpperTheory.Comparison₂.level_family","Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.PrimePairSizeCondition","Formalism.HC.PChar.χ"],[45,111,45,112,"UpperTheory.Comparison₂.level_family","Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.PrimePairSizeCondition","Formalism.HC.PChar.χ"],[38,56,38,62,"_private.Development.AutomorphicArithmetic.PrimitiveCosets.LevelFamily.0.UpperTheory.Comparison₂.level_family_sum","Init.Core","if_neg"],[35,32,35,38,"_private.Development.AutomorphicArithmetic.PrimitiveCosets.LevelFamily.0.UpperTheory.Comparison₂.level_family_sum","Init.Core","if_pos"],[33,42,33,43,"_private.Development.AutomorphicArithmetic.PrimitiveCosets.LevelFamily.0.UpperTheory.Comparison₂.level_family_sum","Init.Prelude","And.left"],[23,13,23,17,"_private.Development.AutomorphicArithmetic.PrimitiveCosets.LevelFamily.0.UpperTheory.Comparison₂.level_family_adm","Init.Prelude","Eq.symm"],[35,45,35,50,"_private.Development.AutomorphicArithmetic.PrimitiveCosets.LevelFamily.0.UpperTheory.Comparison₂.level_family_sum","Init.Prelude","Eq.trans"],[24,10,24,16,"_private.Development.AutomorphicArithmetic.PrimitiveCosets.LevelFamily.0.UpperTheory.Comparison₂.level_family_adm","Init.Prelude","Or.inr"],[51,20,51,21,"UpperTheory.Comparison₂.level_family","Init.Prelude","Subtype.property"],[43,56,43,57,"UpperTheory.Comparison₂.level_family","Init.Prelude","Subtype.val"],[43,73,43,74,"UpperTheory.Comparison₂.level_family","Init.Prelude","Subtype.val"],[43,91,43,92,"UpperTheory.Comparison₂.level_family","Init.Prelude","Subtype.val"],[43,150,43,151,"UpperTheory.Comparison₂.level_family","Init.Prelude","Subtype.val"],[43,211,43,212,"UpperTheory.Comparison₂.level_family","Init.Prelude","Subtype.val"],[43,267,43,268,"UpperTheory.Comparison₂.level_family","Init.Prelude","Subtype.val"],[51,16,51,17,"UpperTheory.Comparison₂.level_family","Init.Prelude","Subtype.val"],[35,11,35,19,"_private.Development.AutomorphicArithmetic.PrimitiveCosets.LevelFamily.0.UpperTheory.Comparison₂.level_family_sum","Init.Prelude","congrArg"],[35,39,35,42,"_private.Development.AutomorphicArithmetic.PrimitiveCosets.LevelFamily.0.UpperTheory.Comparison₂.level_family_sum","Init.Prelude","rfl"],[29,8,29,28,"_private.Development.AutomorphicArithmetic.PrimitiveCosets.LevelFamily.0.UpperTheory.Comparison₂.level_family_sum","Mathlib.Algebra.BigOperators.Group.Finset.Basic","Finset.add_sum_erase"],[45,10,45,29,"UpperTheory.Comparison₂.level_family","Mathlib.Algebra.BigOperators.Group.Finset.Basic","Finset.sum_coe_sort"],[36,11,36,27,"_private.Development.AutomorphicArithmetic.PrimitiveCosets.LevelFamily.0.UpperTheory.Comparison₂.level_family_sum","Mathlib.Algebra.BigOperators.Group.Finset.Basic","Finset.sum_congr"],[33,12,33,19,"_private.Development.AutomorphicArithmetic.PrimitiveCosets.LevelFamily.0.UpperTheory.Comparison₂.level_family_sum","Mathlib.Algebra.Group.Defs","one_mul"],[14,10,14,17,"_private.Development.AutomorphicArithmetic.PrimitiveCosets.LevelFamily.0.UpperTheory.Comparison₂.level_family_wt_pos","Mathlib.Algebra.Order.ZeroLEOne","one_pos"],[15,10,15,17,"_private.Development.AutomorphicArithmetic.PrimitiveCosets.LevelFamily.0.UpperTheory.Comparison₂.level_family_wt_pos","Mathlib.Algebra.Order.ZeroLEOne","one_pos"],[35,52,35,69,"_private.Development.AutomorphicArithmetic.PrimitiveCosets.LevelFamily.0.UpperTheory.Comparison₂.level_family_sum","Mathlib.Data.Complex.Basic","Complex.ofReal_re"],[27,87,27,89,"_private.Development.AutomorphicArithmetic.PrimitiveCosets.LevelFamily.0.UpperTheory.Comparison₂.level_family_sum","Mathlib.Data.Complex.Basic","Complex.re"],[35,20,35,30,"_private.Development.AutomorphicArithmetic.PrimitiveCosets.LevelFamily.0.UpperTheory.Comparison₂.level_family_sum","Mathlib.Data.Complex.Basic","Complex.re"],[45,116,45,118,"UpperTheory.Comparison₂.level_family","Mathlib.Data.Complex.Basic","Complex.re"],[37,32,37,54,"_private.Development.AutomorphicArithmetic.PrimitiveCosets.LevelFamily.0.UpperTheory.Comparison₂.level_family_sum","Mathlib.Data.Finset.Erase","Finset.ne_of_mem_erase"],[8,92,8,93,"_private.Development.AutomorphicArithmetic.PrimitiveCosets.LevelFamily.0.UpperTheory.Comparison₂.level_family_wt","Mathlib.Data.Real.Basic","Real"],[26,74,26,75,"_private.Development.AutomorphicArithmetic.PrimitiveCosets.LevelFamily.0.UpperTheory.Comparison₂.level_family_sum","Mathlib.Data.Real.Basic","Real"],[22,8,22,38,"_private.Development.AutomorphicArithmetic.PrimitiveCosets.LevelFamily.0.UpperTheory.Comparison₂.level_family_adm","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.IsPrimitive"],[22,43,22,75,"_private.Development.AutomorphicArithmetic.PrimitiveCosets.LevelFamily.0.UpperTheory.Comparison₂.level_family_adm","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.conductor_one"]],"source":"import Development.AutomorphicArithmetic.PrimitiveCosets.CoreAtH\nimport Development.AutomorphicArithmetic.PrimitiveCosets.GChiEq\nimport Development.AutomorphicArithmetic.PrimitiveCosets.GzEq\n\nopen UpperTheory.Comparison₂ Deduction.CH Formalism Formalism.HC Formalism.D5 Formalism.RankGapBounds.WeightedMeanData Formalism.LFunctionChainParameters.WeightedSlopeBounds Formalism.LFunctionChainParameters.characterSumData Formalism.LFunctionChainParameters.ThickSetMeanBounds Formalism.LFunctionChainParameters.LErr\n  Formalism.LFunctionChainParameters.LChain Formalism.LFunctionChainParameters.LHost\n\nopen Classical in\nprivate noncomputable def UpperTheory.Comparison₂.level_family_wt (Λ : Level) (ψ : PChar) : ℝ :=\n  if ψ = PChar.one then 1 else Λ.wt ψ\n\nprivate theorem UpperTheory.Comparison₂.level_family_wt_pos (Λ : Level) (ψ : PChar) : 0 < UpperTheory.Comparison₂.level_family_wt Λ ψ := by\n  unfold UpperTheory.Comparison₂.level_family_wt Level.wt\n  split_ifs\n  · exact one_pos\n  · exact one_pos\n  · positivity\n\nprivate theorem UpperTheory.Comparison₂.level_family_adm (ψ : PChar) : ψ.N = 1 ∨ ψ.χ ≠ 1 := by\n  by_cases h : ψ.χ = 1\n  · left\n    have hp := ψ.prim\n    rw [DirichletCharacter.IsPrimitive, h, DirichletCharacter.conductor_one] at hp\n    exact hp.symm\n  · exact Or.inr h\n\nprivate theorem UpperTheory.Comparison₂.level_family_sum (Λ : Level) (y : ℝ) :\n    ∑ ψ ∈ Λ.KEPT, UpperTheory.Comparison₂.level_family_wt Λ ψ * (Deduction.Gchi ψ.χ y).re = Λ.Gm y := by\n  classical\n  rw [← Finset.add_sum_erase _ _ Λ.one_mem, Level.Gm, Level.Nt]\n  congr 1\n  · have h1 : UpperTheory.Comparison₂.level_family_wt Λ PChar.one = 1 := by\n      simp [UpperTheory.Comparison₂.level_family_wt]\n    rw [h1, one_mul, ← gChi_eq, (Gz_eq y).1]\n    simp only [An.gChi, PChar.one]\n    exact (congrArg Complex.re (if_pos rfl)).trans (Complex.ofReal_re _)\n  · refine Finset.sum_congr (by congr) fun ψ hψ => ?_\n    have hne : ψ ≠ PChar.one := Finset.ne_of_mem_erase hψ\n    simp only [UpperTheory.Comparison₂.level_family_wt, if_neg hne, gChi_eq]\n\ntheorem UpperTheory.Comparison₂.level_family :\n    ∀ Λ : Level, ∃ F : Deduction.CharFamily, (∀ y, Deduction.Gm F y = Λ.Gm y) ∧ ∀ θ, Deduction.ZeroFree F θ ↔ Λ.ZeroFreeAbove θ := by\n  intro Λ\n  refine ⟨@Deduction.CharFamily.mk Λ.KEPT _ (fun i => i.1.N) (fun i => i.1.ne) (fun i => i.1.χ) (fun i => UpperTheory.Comparison₂.level_family_wt Λ i.1) (fun i => UpperTheory.Comparison₂.level_family_wt_pos Λ i.1) (fun i => UpperTheory.Comparison₂.level_family_adm i.1), fun y => ?_, fun θ => ?_⟩\n  · rw [← UpperTheory.Comparison₂.level_family_sum Λ y, Deduction.Gm]\n    exact Finset.sum_coe_sort Λ.KEPT (fun ψ => UpperTheory.Comparison₂.level_family_wt Λ ψ * (Deduction.Gchi ψ.χ y).re)\n  · simp only [Deduction.ZeroFree, Level.ZeroFreeAbove, PChar.ZeroFreeAbove]\n    constructor\n    · intro h ψ hψ s hs\n      exact h ⟨ψ, hψ⟩ s hs\n    · intro h i s hs\n      exact h i.1 i.2 s hs\n","kernel":true}