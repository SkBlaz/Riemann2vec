,"Formalism.MainNotions.NoGain","Formalism.SharpRestriction.GrowthBounds.IsResidueClassZero","Formalism.MainNotions.G.rhoB"],[26,76,26,82,"Formalism.MainNotions.NoGain","Formalism.SharpRestriction.GrowthBounds.IsResidueClassZero","Formalism.MainNotions.G.rhoB"],[78,37,78,43,"Formalism.MainNotions.FamP","Formalism.SharpRestriction.GrowthBounds.IsResidueClassZero","Formalism.MainNotions.G.rhoB"],[98,52,98,56,"Formalism.MainNotions.DFamP","Formalism.SharpRestriction.ParConsts","Formalism.MainNotions.FamP"],[83,24,83,30,"Formalism.MainNotions.FamP","Formalism.SharpRestriction.ParConsts","Formalism.MainNotions.NoGain"],[34,34,34,43,"Formalism.MainNotions.FamP","Formalism.SharpRestriction.ParConsts","Formalism.MainNotions.parConsts"],[90,48,90,51,"Formalism.MainNotions.FamP","Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.ZsmulGeneratorEqZeroOfProjection","Formalism.HC.Frame.A.val"],[90,72,90,75,"Formalism.MainNotions.FamP","Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.ZsmulGeneratorEqZeroOfProjection","Formalism.HC.Frame.A.val"],[91,76,91,79,"Formalism.MainNotions.FamP","Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.ZsmulGeneratorEqZeroOfProjection","Formalism.HC.Frame.A.val"],[91,85,91,88,"Formalism.MainNotions.FamP","Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.ZsmulGeneratorEqZeroOfProjection","Formalism.HC.Frame.A.val"],[91,93,91,96,"Formalism.MainNotions.FamP","Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.ZsmulGeneratorEqZeroOfProjection","Formalism.HC.Frame.A.val"],[91,102,91,105,"Formalism.MainNotions.FamP","Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.ZsmulGeneratorEqZeroOfProjection","Formalism.HC.Frame.A.val"],[92,22,92,25,"Formalism.MainNotions.FamP","Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.ZsmulGeneratorEqZeroOfProjection","Formalism.HC.Frame.A.val"],[92,49,92,52,"Formalism.MainNotions.FamP","Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.ZsmulGeneratorEqZeroOfProjection","Formalism.HC.Frame.A.val"],[93,74,93,77,"Formalism.MainNotions.FamP","Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.ZsmulGeneratorEqZeroOfProjection","Formalism.HC.Frame.A.val"],[93,83,93,86,"Formalism.MainNotions.FamP","Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.ZsmulGeneratorEqZeroOfProjection","Formalism.HC.Frame.A.val"],[94,20,94,25,"Formalism.MainNotions.FamP","Init.Prelude","Bool.false"],[94,49,94,54,"Formalism.MainNotions.FamP","Init.Prelude","Bool.false"],[18,70,18,74,"Formalism.MainNotions.parConsts","Init.Prelude","List"],[33,7,33,11,"Formalism.MainNotions.FamP","Init.Prelude","List"],[37,7,37,11,"Formalism.MainNotions.FamP","Init.Prelude","List"],[23,84,23,85,"Formalism.MainNotions.NoGain","Init.Prelude","Nat"],[26,39,26,40,"Formalism.MainNotions.NoGain","Init.Prelude","Nat"],[57,39,57,40,"Formalism.MainNotions.FamP","Init.Prelude","Nat"],[82,45,82,50,"Formalism.MainNotions.FamP","Mathlib.Data.Nat.Prime.Defs","Nat.Prime"],[18,75,18,76,"Formalism.MainNotions.parConsts","Mathlib.Data.Real.Basic","Real"],[23,76,23,77,"Formalism.MainNotions.NoGain","Mathlib.Data.Real.Basic","Real"],[24,8,24,9,"Formalism.MainNotions.NoGain","Mathlib.Data.Real.Basic","Real"],[25,30,25,31,"Formalism.MainNotions.NoGain","Mathlib.Data.Real.Basic","Real"],[26,28,26,29,"Formalism.MainNotions.NoGain","Mathlib.Data.Real.Basic","Real"],[26,56,26,57,"Formalism.MainNotions.NoGain","Mathlib.Data.Real.Basic","Real"],[28,24,28,25,"Formalism.MainNotions.NoGain","Mathlib.Data.Real.Basic","Real"],[30,22,30,23,"Formalism.MainNotions.FamP","Mathlib.Data.Real.Basic","Real"],[33,12,33,13,"Formalism.MainNotions.FamP","Mathlib.Data.Real.Basic","Real"],[37,12,37,13,"Formalism.MainNotions.FamP","Mathlib.Data.Real.Basic","Real"],[41,8,41,9,"Formalism.MainNotions.FamP","Mathlib.Data.Real.Basic","Real"],[57,44,57,45,"Formalism.MainNotions.FamP","Mathlib.Data.Real.Basic","Real"],[68,8,68,9,"Formalism.MainNotions.FamP","Mathlib.Data.Real.Basic","Real"],[78,78,78,79,"Formalism.MainNotions.FamP","Mathlib.Data.Real.Basic","Real"],[80,7,80,8,"Formalism.MainNotions.FamP","Mathlib.Data.Real.Basic","Real"],[98,28,98,29,"Formalism.MainNotions.DFamP","Mathlib.Data.Real.Basic","Real"],[25,6,25,16,"Formalism.MainNotions.NoGain","Mathlib.GroupTheory.OrderOfElement","addOrderOf"]],"source":"import Formalism.SharpRestriction.FamCore\nimport Formalism.SharpRestriction.ElevenLe\nimport Formalism.LocalRingCardinality.DataParams\nimport Formalism.LocalRingCardinality.DataDIV\nimport Formalism.LocalRingCardinality.DataTies\nimport Formalism.LocalRingCardinality.DataParamsT\nimport Formalism.LocalRingCardinality.KernelPlaceMeanBound\nimport Formalism.LocalRingCardinality.DataExtra\nimport Formalism.LocalRingCardinality.DataDIVDefs\nimport Formalism.LocalRingCardinality.DataGatTies\nimport Formalism.SharpRestriction.GrowthBounds.IsResidueClassZero\n\nnoncomputable section\n\nnamespace Formalism.MainNotions\n\nopen Formalism.BasicNotions\n\ndef parConsts {D : D7} {L : SizeData₂ D} (P : ParameterChoice' D L) : List ℝ :=\n  [P.CkLow, P.Ck6, P.CfL, P.cLL, P.CnW, P.Crho, P.CDelG, P.CLw,\n    P.Cj0, P.Cw, P.cw, P.CDel, P.CCount, P.Ch0r, P.Ch0k, P.Ch0N,\n    P.Cgap, P.CetaF, P.CY, P.CYL, P.Cpde, P.CccK, P.CF]\n\ndef NoGain {D : D7} {L : SizeData₂ D} (X : G.Inst D L) (K : G.Consts) (Cr : ℝ) (p : ℕ) : Prop :=\n  ((p : ℝ) < L.sc.X' * (1 + Cr * G.rhoB D K L.sc) ∧ G.IsResidueClassZero D p ∧\n    ((addOrderOf (G.hP D p) : ℝ) < L.sc.x ^ (L.sc.eps / 4) ∨\n      (L.sc.p0 D.R.k ≤ (p : ℝ) ∧ ∃ i : ℕ, 1 ≤ i ∧ |(p : ℝ) ^ i - L.sc.X'| ≤ G.rhoB D K L.sc * L.sc.X') ∨\n      (G.Cand D L K p ∧ L.sc.x ^ (-L.sc.eps) < G.Sig X K (G.aL L) (G.bL L) p))) ∨\n  L.sc.X'' D.R.n < (p : ℝ) ∨ ¬ (G.IsResidueClassZero D p ∨ G.IsSg D p) ∨ G.IsCs D p\n\nstructure FamP (eps : ℝ) extends FamCore eps where\n\n  params : ∀ x, x1 < x → ∀ i : Ix x, ParameterChoice' (D x i) (L x i)\n  PK : List ℝ\n  params_K : ∀ x (hx : x1 < x) i, parConsts (params x hx i) = PK\n\n  parT : ∀ x (hx : x1 < x) (i : Ix x), ParamsT (D x i) (L x i) (params x hx i)\n  PT : List ℝ\n  parT_K : ∀ x (hx : x1 < x) i, [(parT x hx i).CP, (parT x hx i).eP, (parT x hx i).Cp, (parT x hx i).Cb,\n    (parT x hx i).cTO, (parT x hx i).ChT, (parT x hx i).CbN] = PT\n\n  CTu : ℝ\n\n  sizes : ∀ x, x1 < x → ∀ i : Ix x, SizesAt (L x i)\n\n  ties : ∀ x (i : Ix x), Ties (D x i)\n\n  gatT : ∀ x (i : Ix x), GatTies (D x i)\n\n  X : ∀ x (i : Ix x), DivX (D x i)\n\n  Gx : ∀ x (i : Ix x), G.Inst (D x i) (L x i)\n  Gy : ∀ x (i : Ix x), G.LatInst (D x i)\n  GK : G.Consts\n  GK_nonneg : GK.Nonneg\n\n  supp_sat : ∀ x, x1 < x → ∀ (i : Ix x) w,\n    (((D x i).what₂.places.resChar w : ℕ) : ℝ) ≤ (L x i).sc.X'' (D x i).R.n → w ∈ (L x i).supp\n\n  tw_supp : ∀ x, x1 < x → ∀ (i : Ix x) w, (D x i).what₂.muAt w ≠ (D x i).what₂.mu0 → w ∈ (L x i).supp\n\n  fills : ∀ x, x1 < x → ∀ (i : Ix x) w, G.ParametersFill (Gx x i) GK w\n  lats0 : ∀ x, x1 < x → ∀ (i : Ix x) w u,\n    G.VV (Gx x i) GK (G.aL (L x i)) (G.bL (L x i)) ((D x i).what₂.places.resChar w) = ∅ →\n    (D x i).what₂.places.resChar w ≠ ((D x i).mem u).A.T → (L x i).lenMN u w = 0\n\n  latTied : ∀ x, x1 < x → ∀ i : Ix x, G.LatTied (gatT x i) (Gx x i) (Gy x i)\n\n  Csz : ℝ\n  nuDef : ∀ x, x1 < x → ∀ i : Ix x, DV.NuDef (D x i) (L x i)\n  nprimeDef : ∀ x, x1 < x → ∀ i : Ix x, DV.NprimeDef (D x i) (L x i)\n  rrDef : ∀ x, x1 < x → ∀ i : Ix x, DV.RRDef (D x i)\n  h_eq : ∀ x, x1 < x → ∀ (i : Ix x) u, (D x i).div.h u = DV.hExpl6 (D x i) (L x i) (X x i) Csz u\n\n  cX : ExtraC\n\n  ex : ∀ x, x1 < x → ∀ i : Ix x, Extra (D x i) (L x i) (gatT x i) (Gx x i) (Gy x i) GK (X x i) cX\n\n  rho_le : ∀ x, x1 < x → ∀ i : Ix x, G.rhoB (D x i) GK (L x i).sc ≤ x ^ (-2 : ℝ)\n\n  Cr : ℝ\n  one_le_Cr : 1 ≤ Cr\n  drop_iff : ∀ x, x1 < x → ∀ (i : Ix x) p, p.Prime →\n    (p ∈ (L x i).drop ↔ NoGain (Gx x i) GK Cr p ∧ ∀ u, p ≠ ((D x i).mem u).A.T)\n\n  fixed : GK.Pr1 = 1 ∧ GK.dl1 = 5 ∧ GK.dl2 = 4 ∧ cX.Ce = 1 ∧ cX.err.c6 = 12 ∧ cX.err.dig = 3 ∧ Cr = 1 ∧\n    ∀ x (hx : x1 < x) (i : Ix x), (params x hx i).CnW = 10 ∧ 12 ≤ (parT x hx i).eP\n\n  eta_eq : ∀ x (i i' : Ix x), (L x i).etaSz = (L x i').etaSz\n  Sc_shared : ∀ x (i i' : Ix x), (L x i).Sc = (L x i').Sc\n  hP_eq : ∀ x (i i' : Ix x) p, (G.hP (D x i) p).val = (G.hP (D x i') p).val\n  bs_eq : ∀ x (i i' : Ix x) (h t : G.HH (D x i)) (h' t' : G.HH (D x i')), h.val = h'.val → t.val = t'.val →\n    ((Gx x i).bs h t).val = ((Gx x i').bs h' t').val\n  off_eq : ∀ x (i i' : Ix x) j (t : G.HH (D x i)) (t' : G.HH (D x i')), t.val = t'.val →\n    (Gx x i).off j (false, t) = (Gx x i').off j (false, t')\n  kapI_eq : ∀ x (i i' : Ix x), (Gx x i).kapI = (Gx x i').kapI\n  ep_eq : ∀ x (i i' : Ix x), (Gx x i).ep = (Gx x i').ep\n\ndef DFamP : Type 1 := ∀ ε : ℝ, 0 < ε → ε < 1 / 52 → FamP ε\n\nend Formalism.MainNotions\n\nend\n","kernel":true}