ctrum"],[39,61,39,78,"UpperTheory.GalStar.AboveB","Mathlib.RingTheory.DedekindDomain.Ideal.Lemmas","IsDedekindDomain.HeightOneSpectrum"],[57,16,57,33,"UpperTheory.GalStar.PropsB","Mathlib.RingTheory.DedekindDomain.Ideal.Lemmas","IsDedekindDomain.HeightOneSpectrum"],[64,11,64,28,"UpperTheory.GalStar.PropsB","Mathlib.RingTheory.DedekindDomain.Ideal.Lemmas","IsDedekindDomain.HeightOneSpectrum"],[57,69,57,76,"UpperTheory.GalStar.PropsB","Mathlib.RingTheory.DedekindDomain.Ideal.Lemmas","IsDedekindDomain.HeightOneSpectrum.asIdeal"],[23,7,23,23,"","Mathlib.RingTheory.Valuation.ValuationSubring","ValuationSubring"],[39,92,39,108,"UpperTheory.GalStar.AboveB","Mathlib.RingTheory.Valuation.ValuationSubring","ValuationSubring"],[57,83,57,99,"UpperTheory.GalStar.PropsB","Mathlib.RingTheory.Valuation.ValuationSubring","ValuationSubring"],[64,42,64,58,"UpperTheory.GalStar.PropsB","Mathlib.RingTheory.Valuation.ValuationSubring","ValuationSubring"],[15,67,15,77,"UpperTheory.GalStar.IsQpBig","Mathlib.Topology.Defs.Basic","Continuous"],[55,9,55,19,"UpperTheory.GalStar.PropsB","Mathlib.Topology.Defs.Basic","Continuous"],[40,69,40,85,"UpperTheory.GalStar.AboveB","Mathlib.Topology.Defs.Basic","TopologicalSpace"],[65,49,65,65,"UpperTheory.GalStar.PropsB","Mathlib.Topology.Defs.Basic","TopologicalSpace"],[41,27,41,30,"UpperTheory.GalStar.AboveB","ReciprocityTheory.GaloisValuations.Global","ReciprocityTheory.Gal.Dec"],[42,78,42,81,"UpperTheory.GalStar.AboveB","ReciprocityTheory.GaloisValuations.Global","ReciprocityTheory.Gal.Dec"],[43,25,43,28,"UpperTheory.GalStar.AboveB","ReciprocityTheory.GaloisValuations.Global","ReciprocityTheory.Gal.Dec"],[45,30,45,33,"UpperTheory.GalStar.AboveB","ReciprocityTheory.GaloisValuations.Global","ReciprocityTheory.Gal.Dec"],[48,25,48,28,"UpperTheory.GalStar.AboveB","ReciprocityTheory.GaloisValuations.Global","ReciprocityTheory.Gal.Dec"],[48,74,48,77,"UpperTheory.GalStar.AboveB","ReciprocityTheory.GaloisValuations.Global","ReciprocityTheory.Gal.Dec"],[50,30,50,33,"UpperTheory.GalStar.AboveB","ReciprocityTheory.GaloisValuations.Global","ReciprocityTheory.Gal.Dec"],[51,37,51,40,"UpperTheory.GalStar.AboveB","ReciprocityTheory.GaloisValuations.Global","ReciprocityTheory.Gal.Dec"],[66,29,66,32,"UpperTheory.GalStar.PropsB","ReciprocityTheory.GaloisValuations.Global","ReciprocityTheory.Gal.Dec"]],"source":"import Development.AutomorphicArithmetic.Foundations.GaloisRepresentations.TypeConditions.WeightsConjAlt\n\nnoncomputable section\n\nopen NumberField IsDedekindDomain Neutral.B1 Formalism.L2.Host Formalism.ConjugateSelfDual ReciprocityTheory.Gal Formalism.BasicNotions Formalism.BasicNotions.Loc Formalism.MainNotions.N Polynomial\nopen GlobalTheory GlobalTheory.CuspRep GlobalTheory.WeilDeligne GlobalTheory.Pst GlobalTheory.LocLanglands GlobalTheory.HeckeGal GlobalTheory.LocGL GlobalTheory.GalOfCusp\nopen scoped commutatorElement\n\nattribute [local instance] GlobalTheory.LocalData.complRel GlobalTheory.LocalData.isLocalField\n\nnamespace UpperTheory.GalStar\n\nopen UpperTheory.GalS (TmW)\n\ndef IsQpBig {E : Type} [Field E] [NumberField E] (w : HeightOneSpectrum (𝓞 E)) (n : ℕ) : Prop :=\n  ∃ (g : ℕ) (_ : Fact g.Prime) (i : ℚ_[g] ≃+* w.adicCompletion E), Continuous i ∧ (n = 1 ∨ 16 * n ^ 2 < g)\n\ntheorem IsQpBig.isQp {E : Type} [Field E] [NumberField E] {w : HeightOneSpectrum (𝓞 E)} {n : ℕ} (k : IsQpBig w n) : IsQp w := by\n  obtain ⟨g, p, i, c, -⟩ := k\n  exact ⟨g, p, i, c⟩\n\nsection Local\nvariable {E Ω : Type} [Field E] [NumberField E] [Field Ω] [Algebra E Ω] [IsAlgClosure E Ω]\n  {A : ValuationSubring Ω} {w : HeightOneSpectrum (𝓞 E)} {h : IsPlaceOver A w}\n\nstructure AwayB (x y : WD h) : Prop where\n  dim : x.lpDim = y.lpDim\n\n  tor : Tor y → y.mono0 → x = y\n\n  tame0 : IsQpBig w y.lpDim → TmW y → Sqf y → y.mono0 → x.mono0 ∧ ∀ g : ↥(Weil h), deg g = 0 → x.charPol g = y.charPol g\n\ntheorem Away.big {x y : WD h} (k : Away x y) : AwayB x y := ⟨k.dim, k.tor, fun q => k.tame0 q.isQp⟩\nend Local\n\nvariable (Rc : RecNotion) {E Ω : Type} [Field E] [NumberField E] [Field Ω] [Algebra E Ω] {l : ℕ} [Fact l.Prime] {a : ℕ}\n  [IsAlgClosure E Ω] [IsCMField E]\n\nstructure AboveB (π : CuspSub E a) (ι : Qbar l ≃+* ℂ) (r : G E Ω →* GL (Fin a) (Qbar l))\n    (HT : (E →+* Qbar l) → Multiset ℤ) (P : LocPrime l) {w : HeightOneSpectrum (𝓞 E)} {A : ValuationSubring Ω}\n    (h : IsPlaceOver A w) {O : Type} [CommRing O] [Algebra ℤ_[l] O] [TopologicalSpace O]\n    (Bw : LocBridge l E Ω (Dec (F := E) A) O) (hj : Pst.Induces Bw) : Prop where\n  crys : ∀ σ, π.IsLocComp w σ → SmGL.IsSpherical σ.ρ → IsCrysAt P Bw (r.comp (Dec (F := E) A).subtype) ∧\n    IsdRAt P Bw (r.comp (Dec (F := E) A).subtype) ∧\n    ∀ (τ : E →+* Qbar l) (LL' : FinExt l) (τ' : ↥Bw.Kw.1 →ₐ[ℚ_[l]] ↥LL'.1), IsInduced Bw τ τ' →\n      IsJumpsAt P Bw (r.comp (Dec (F := E) A).subtype) τ (HT τ)\n\n  nice : ∀ σ, π.IsLocComp w σ → ∀ rc, Rc h rc → ((IsQpBig w a ∧ TmW (rc (algNorm σ)) ∧ Sqf (rc (algNorm σ))) ∨ Tor (rc (algNorm σ))) → (rc (algNorm σ)).mono0 →\n    IsdRAt P Bw (r.comp (Dec (F := E) A).subtype) ∧ IsPstAt P Bw (r.comp (Dec (F := E) A).subtype) ∧\n    (∀ (τ : E →+* Qbar l) (LL' : FinExt l) (τ' : ↥Bw.Kw.1 →ₐ[ℚ_[l]] ↥LL'.1), IsInduced Bw τ τ' →\n      IsJumpsAt P Bw (r.comp (Dec (F := E) A).subtype) τ (HT τ)) ∧\n    AwayB (wdAt P ι Bw h hj (r.comp (Dec (F := E) A).subtype)) (rc (algNorm σ))\n\nstructure PropsB (π : CuspSub E a) (ι : Qbar l ≃+* ℂ)\n    (r : G E Ω →* GL (Fin a) (Qbar l)) (wt : ℤ) (HT : (E →+* Qbar l) → Multiset ℤ) : Prop where\n  cont : Continuous r\n  ss : IsSSRep r\n  away : ∀ (w : HeightOneSpectrum (𝓞 E)) (hl : ((l : ℕ) : 𝓞 E) ∉ w.asIdeal) (A : ValuationSubring Ω) (h : IsPlaceOver A w)\n    (rc : IrrGL (w.adicCompletion E) → WD h), Rc h rc → ∀ σ, π.IsLocComp w σ → AwayB (wdOf h hl ι r) (rc (algNorm σ))\n  weights : ∀ τ : E →+* Qbar l, (HT τ).map (fun n : ℤ => (n : ℂ)) =\n    ((CG.mk π).infChar (ι.toRingHom.comp τ)).map fun z => ((a : ℂ) - 1) / 2 - z\n  weights_conj : ∀ τ : E →+* Qbar l,\n    HT (τ.comp (IsCMField.complexConj E).toRingEquiv.toRingHom) = (HT τ).map (wt - ·)\n  above : ∀ (P : LocPrime l) (AI : LocAinf l P), Nonempty (LocTied l P AI) →\n    ∀ (w : HeightOneSpectrum (𝓞 E)) (A : ValuationSubring Ω) (h : IsPlaceOver A w)\n      (O : Type) [CommRing O] [Algebra ℤ_[l] O] [TopologicalSpace O]\n      (Bw : LocBridge l E Ω (Dec (F := E) A) O) (hj : Pst.Induces Bw), AboveB Rc π ι r HT P h Bw hj\n\ndef Row0b : Prop :=\n  ∀ (E Ω : Type) [Field E] [NumberField E] [IsCMField E] [Field Ω] [Algebra E Ω] [IsAlgClosure E Ω]\n    (l : ℕ) [Fact l.Prime] (ι : Qbar l ≃+* ℂ) (a : ℕ), 1 ≤ a →\n    ∀ (π : CuspSub E a) (χ : HChar (maximalRealSubfield E)), (CG.mk π).IsRegAlg → GlobalTheory.ContraPair.PolarizedPair π χ →\n      ∃ (r : G E Ω →* GL (Fin a) (Qbar l)) (wt : ℤ) (HT : (E →+* Qbar l) → Multiset ℤ), PropsB Rc π ι r wt HT\n\ntheorem Props.big {π : CuspSub E a} {ι : Qbar l ≃+* ℂ} {r : G E Ω →* GL (Fin a) (Qbar l)} {wt : ℤ}\n    {HT : (E →+* Qbar l) → Multiset ℤ} (k : Props Rc π ι r wt HT) : PropsB Rc π ι r wt HT :=\n  ⟨k.cont, k.ss, fun w hl A h rc hrc σ hσ => (k.away w hl A h rc hrc σ hσ).big, k.weights, k.weights_conj,\n    fun P AI T w A h O _ _ _ Bw hj =>\n      have j := k.above P AI T w A h O Bw hj\n      ⟨j.crys, fun σ hσ rc hrc g m =>\n        have n := j.nice σ hσ rc hrc (g.imp (fun q => ⟨q.1.isQp, q.2⟩) id) m\n        ⟨n.1, n.2.1, n.2.2.1, n.2.2.2.big⟩⟩⟩\n\ntheorem Row0.row0b (H : Row0 Rc) : Row0b Rc := fun E Ω _ _ _ _ _ _ l _ ι a ha π χ hr hp => by\n  obtain ⟨r, wt, HT, k⟩ := H E Ω l ι a ha π χ hr hp\n  exact ⟨r, wt, HT, k.big Rc⟩\n\nend UpperTheory.GalStar\n","kernel":true}