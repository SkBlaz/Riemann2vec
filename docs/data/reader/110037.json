.Data.NeZero","NeZero"],[10,53,10,56,"Deduction.ramp","Init.Prelude","Max.max"],[9,14,9,15,"Deduction.ramp","Init.Prelude","Nat"],[14,14,14,15,"Deduction.Gchi","Init.Prelude","Nat"],[26,10,26,11,"Deduction.CharFamily","Init.Prelude","Nat"],[18,39,18,44,"Deduction.Gchi","Mathlib.Analysis.Calculus.Deriv.Basic","deriv"],[16,34,16,42,"Deduction.Gchi","Mathlib.Analysis.SpecialFunctions.Log.Basic","Real.log"],[21,33,21,41,"Deduction.G","Mathlib.Analysis.SpecialFunctions.Log.Basic","Real.log"],[9,18,9,19,"Deduction.ramp","Mathlib.Data.Complex.Basic","Complex"],[9,31,9,32,"Deduction.ramp","Mathlib.Data.Complex.Basic","Complex"],[10,40,10,41,"Deduction.ramp","Mathlib.Data.Complex.Basic","Complex"],[10,78,10,79,"Deduction.ramp","Mathlib.Data.Complex.Basic","Complex"],[14,52,14,53,"Deduction.Gchi","Mathlib.Data.Complex.Basic","Complex"],[14,67,14,68,"Deduction.Gchi","Mathlib.Data.Complex.Basic","Complex"],[16,52,16,53,"Deduction.Gchi","Mathlib.Data.Complex.Basic","Complex"],[16,105,16,106,"Deduction.Gchi","Mathlib.Data.Complex.Basic","Complex"],[18,33,18,34,"Deduction.Gchi","Mathlib.Data.Complex.Basic","Complex"],[28,30,28,31,"Deduction.CharFamily","Mathlib.Data.Complex.Basic","Complex"],[38,13,38,14,"Deduction.ZeroFree","Mathlib.Data.Complex.Basic","Complex"],[21,24,21,26,"Deduction.G","Mathlib.Data.Complex.Basic","Complex.re"],[35,69,35,71,"Deduction.Gm","Mathlib.Data.Complex.Basic","Complex.re"],[38,22,38,24,"Deduction.ZeroFree","Mathlib.Data.Complex.Basic","Complex.re"],[10,8,10,20,"Deduction.ramp","Mathlib.Data.Finset.Range","Finset.range"],[25,9,25,16,"Deduction.CharFamily","Mathlib.Data.Fintype.Defs","Fintype"],[9,26,9,27,"Deduction.ramp","Mathlib.Data.Real.Basic","Real"],[10,73,10,74,"Deduction.ramp","Mathlib.Data.Real.Basic","Real"],[14,62,14,63,"Deduction.Gchi","Mathlib.Data.Real.Basic","Real"],[16,47,16,48,"Deduction.Gchi","Mathlib.Data.Real.Basic","Real"],[16,100,16,101,"Deduction.Gchi","Mathlib.Data.Real.Basic","Real"],[20,11,20,12,"Deduction.G","Mathlib.Data.Real.Basic","Real"],[20,16,20,17,"Deduction.G","Mathlib.Data.Real.Basic","Real"],[29,10,29,11,"Deduction.CharFamily","Mathlib.Data.Real.Basic","Real"],[35,29,35,30,"Deduction.Gm","Mathlib.Data.Real.Basic","Real"],[35,34,35,35,"Deduction.Gm","Mathlib.Data.Real.Basic","Real"],[37,35,37,36,"Deduction.ZeroFree","Mathlib.Data.Real.Basic","Real"],[40,38,40,39,"Deduction.WindowHyp","Mathlib.Data.Real.Basic","Real"],[41,8,41,9,"Deduction.WindowHyp","Mathlib.Data.Real.Basic","Real"],[41,26,41,27,"Deduction.WindowHyp","Mathlib.Data.Real.Basic","Real"],[41,35,41,36,"Deduction.WindowHyp","Mathlib.Data.Real.Basic","Real"],[41,53,41,54,"Deduction.WindowHyp","Mathlib.Data.Real.Basic","Real"],[41,57,41,58,"Deduction.WindowHyp","Mathlib.Data.Real.Basic","Real"],[42,4,42,30,"Deduction.WindowHyp","Mathlib.MeasureTheory.Integral.IntegrableOn","MeasureTheory.IntegrableOn"],[10,34,10,35,"Deduction.ramp","Mathlib.NumberTheory.ArithmeticFunction.VonMangoldt","ArithmeticFunction.vonMangoldt"],[14,33,14,51,"Deduction.Gchi","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter"],[28,11,28,29,"Deduction.CharFamily","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter"],[16,64,16,92,"Deduction.Gchi","Mathlib.NumberTheory.Harmonic.EulerMascheroni","Real.eulerMascheroniConstant"],[21,51,21,79,"Deduction.G","Mathlib.NumberTheory.Harmonic.EulerMascheroni","Real.eulerMascheroniConstant"],[18,46,18,74,"Deduction.Gchi","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction"],[18,82,18,110,"Deduction.Gchi","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction"],[38,27,38,55,"Deduction.ZeroFree","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction"],[42,62,42,69,"Deduction.WindowHyp","Mathlib.Order.Interval.Set.Defs","Set.Icc"],[43,11,43,18,"Deduction.WindowHyp","Mathlib.Order.Interval.Set.Defs","Set.Icc"],[44,11,44,18,"Deduction.WindowHyp","Mathlib.Order.Interval.Set.Defs","Set.Icc"]],"source":"import Mathlib\n\nopen scoped ArithmeticFunction.vonMangoldt\nopen Complex\n\nnoncomputable section\n\nnamespace Deduction\n\ndef ramp (f : ℕ → ℂ) (y : ℝ) : ℂ :=\n  ∑ n ∈ Finset.range (⌊y⌋₊ + 1), (Λ n : ℂ) * f n * ((max (y / n - 1) 0 : ℝ) : ℂ)\n\nopen Classical in\n\ndef Gchi {N : ℕ} [NeZero N] (χ : DirichletCharacter ℂ N) (y : ℝ) : ℂ :=\n  if χ = 1 then\n    ramp (fun n => χ n) y - ((y * Real.log y : ℝ) : ℂ) + (((1 + Real.eulerMascheroniConstant) * y : ℝ) : ℂ)\n  else\n    ramp (fun n => χ n) y + (y : ℂ) * (deriv (DirichletCharacter.LFunction χ) 1 / DirichletCharacter.LFunction χ 1)\n\ndef G (y : ℝ) : ℝ :=\n  (ramp (fun _ => 1) y).re - y * Real.log y + (1 + Real.eulerMascheroniConstant) * y\n\nstructure CharFamily where\n  ι : Type\n  [fin : Fintype ι]\n  N : ι → ℕ\n  [nz : ∀ i, NeZero (N i)]\n  χ : ∀ i, DirichletCharacter ℂ (N i)\n  a : ι → ℝ\n  a_pos : ∀ i, 0 < a i\n  adm : ∀ i, N i = 1 ∨ χ i ≠ 1\n\nattribute [instance] CharFamily.fin CharFamily.nz\n\ndef Gm (F : CharFamily) (y : ℝ) : ℝ := ∑ i, F.a i * (Gchi (F.χ i) y).re\n\ndef ZeroFree (F : CharFamily) (θ : ℝ) : Prop :=\n  ∀ i, ∀ s : ℂ, θ < s.re → DirichletCharacter.LFunction (F.χ i) s ≠ 0\n\ndef WindowHyp (F : CharFamily) (θ δ : ℝ) : Prop :=\n  ∀ η : ℝ, 0 < η → ∀ Y₀ : ℝ, ∃ Y : ℝ, Y₀ ≤ Y ∧ ∃ R : ℝ → ℝ,\n    MeasureTheory.IntegrableOn (fun y => R y * y ^ (-θ - 1)) (Set.Icc Y (Y ^ (1 + δ))) ∧\n    (∀ y ∈ Set.Icc Y (Y ^ (1 + δ)), 0 ≤ R y ∧ Gm F y ≤ R y) ∧\n    ∫ y in Set.Icc Y (Y ^ (1 + δ)), R y * y ^ (-θ - 1) ≤ Y ^ η\n\nend Deduction\n\nend\n","kernel":true}