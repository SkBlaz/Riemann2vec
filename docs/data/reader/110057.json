"Deduction.windowHyp_of_rpow","Mathlib.Order.Defs.LinearOrder","le_max_right"],[32,28,32,36,"Deduction.windowHyp_of_rpow","Mathlib.Order.Defs.PartialOrder","le_trans"],[43,13,43,21,"Deduction.windowHyp_of_rpow","Mathlib.Order.Defs.PartialOrder","le_trans"],[40,24,40,38,"Deduction.windowHyp_of_rpow","Mathlib.Order.Defs.PartialOrder","lt_of_lt_of_le"],[46,68,46,82,"Deduction.windowHyp_of_rpow","Mathlib.Order.Defs.PartialOrder","lt_of_lt_of_le"],[48,24,48,38,"Deduction.windowHyp_of_rpow","Mathlib.Order.Defs.PartialOrder","lt_of_lt_of_le"],[53,31,53,45,"Deduction.windowHyp_of_rpow","Mathlib.Order.Defs.PartialOrder","lt_of_lt_of_le"],[54,20,54,34,"Deduction.windowHyp_of_rpow","Mathlib.Order.Defs.PartialOrder","lt_of_lt_of_le"],[12,22,12,45,"Deduction.windowHyp_of_rpow_eventually","Mathlib.Order.Filter.AtTopBot.Basic","Filter.eventually_atTop"],[12,57,12,76,"Deduction.windowHyp_of_rpow_eventually","Mathlib.Order.Filter.AtTopBot.Defs","Filter.eventually_ge_atTop"],[11,37,11,56,"Deduction.windowHyp_of_rpow_eventually","Mathlib.Order.Filter.AtTopBot.Tendsto","Filter.Tendsto.eventually_ge_atTop"],[12,52,12,55,"Deduction.windowHyp_of_rpow_eventually","Mathlib.Order.Filter.Basic","Filter.Eventually.and"],[27,43,27,50,"Deduction.windowHyp_of_rpow","Mathlib.Order.Interval.Set.Defs","Set.Icc"],[38,7,38,14,"Deduction.windowHyp_of_rpow","Mathlib.Order.Interval.Set.Defs","Set.Icc"],[46,50,46,54,"Deduction.windowHyp_of_rpow","Mathlib.Topology.Algebra.GroupWithZero","ContinuousOn.inv₀"],[46,29,46,32,"Deduction.windowHyp_of_rpow","Mathlib.Topology.Algebra.Monoid.Defs","ContinuousOn.mul"],[46,10,46,28,"Deduction.windowHyp_of_rpow","Mathlib.Topology.ContinuousOn","continuousOn_const"],[46,34,46,49,"Deduction.windowHyp_of_rpow","Mathlib.Topology.ContinuousOn","continuousOn_id"]],"source":"import Development.AutomorphicArithmetic.DedekindLFunctions.LandauZeroFreeCriterion\n\nopen Complex MeasureTheory Set Filter Topology\n\nnoncomputable section\n\nnamespace Deduction\n\ntheorem windowHyp_of_rpow_eventually (K η : ℝ) (hK : 0 ≤ K) (hη : 0 < η) :\n    ∃ Y₁ : ℝ, ∀ Y : ℝ, Y₁ ≤ Y → 1 ≤ Y ∧ K * Real.log Y ≤ Y ^ η := by\n  have h2 : 0 < η / 2 := by positivity\n  have h1 := (tendsto_rpow_atTop h2).eventually_ge_atTop (K / (η / 2))\n  obtain ⟨Y₁, hY₁⟩ := Filter.eventually_atTop.1 (h1.and (eventually_ge_atTop (1 : ℝ)))\n  refine ⟨Y₁, fun Y hY => ?_⟩\n  obtain ⟨ha, hb⟩ := hY₁ Y hY\n  refine ⟨hb, ?_⟩\n  have hY0 : 0 < Y := by linarith\n  have hl := Real.log_le_rpow_div hY0.le h2\n  have hp : 0 ≤ Y ^ (η / 2) := by positivity\n  have he : Y ^ η = Y ^ (η / 2) * Y ^ (η / 2) := by\n    rw [← Real.rpow_add hY0]; congr 1; ring\n  calc K * Real.log Y ≤ K * (Y ^ (η / 2) / (η / 2)) := mul_le_mul_of_nonneg_left hl hK\n    _ = K / (η / 2) * Y ^ (η / 2) := by ring\n    _ ≤ Y ^ (η / 2) * Y ^ (η / 2) := mul_le_mul_of_nonneg_right ha hp\n    _ = Y ^ η := he.symm\n\ntheorem windowHyp_of_rpow (F : CharFamily) {θ δ C : ℝ} (hδ : 0 < δ)\n    (h : ∀ Y₀ : ℝ, ∃ Y : ℝ, Y₀ ≤ Y ∧ ∀ y ∈ Set.Icc Y (Y ^ (1 + δ)), Gm F y ≤ C * y ^ θ) :\n    WindowHyp F θ δ := by\n  intro η hη Y₀\n  obtain ⟨Y₁, hY₁⟩ := windowHyp_of_rpow_eventually (|C| * δ) η (by positivity) hη\n  obtain ⟨Y, hY, hb⟩ := h (max Y₀ Y₁)\n  obtain ⟨h1, hK⟩ := hY₁ Y (le_trans (le_max_right _ _) hY)\n  have hY0 : 0 < Y := by linarith\n  have hle : Y ≤ Y ^ (1 + δ) := by\n    calc Y = Y ^ (1 : ℝ) := (Real.rpow_one Y).symm\n      _ ≤ Y ^ (1 + δ) := Real.rpow_le_rpow_of_exponent_le h1 (by linarith)\n  have heq : Set.EqOn (fun y : ℝ => |C| * y ^ θ * y ^ (-θ - 1)) (fun y : ℝ => |C| * y⁻¹)\n      (Set.Icc Y (Y ^ (1 + δ))) := by\n    intro y hy\n    have hy0 : 0 < y := lt_of_lt_of_le hY0 hy.1\n    simp only\n    rw [mul_assoc, ← Real.rpow_add hy0, show θ + (-θ - 1) = -1 by ring, Real.rpow_neg_one]\n  refine ⟨Y, le_trans (le_max_left _ _) hY, fun y => |C| * y ^ θ, ?_, ?_, ?_⟩\n  · refine (integrableOn_congr_fun heq measurableSet_Icc).2 ?_\n    refine ContinuousOn.integrableOn_Icc ?_\n    exact continuousOn_const.mul (continuousOn_id.inv₀ fun y hy => (lt_of_lt_of_le hY0 hy.1).ne')\n  · intro y hy\n    have hy0 : 0 < y := lt_of_lt_of_le hY0 hy.1\n    have hp : 0 ≤ y ^ θ := by positivity\n    exact ⟨by positivity, (hb y hy).trans (mul_le_mul_of_nonneg_right (le_abs_self C) hp)⟩\n  · rw [setIntegral_congr_fun measurableSet_Icc heq, integral_Icc_eq_integral_Ioc,\n      ← intervalIntegral.integral_of_le hle, intervalIntegral.integral_const_mul,\n      integral_inv_of_pos hY0 (lt_of_lt_of_le hY0 hle),\n      Real.log_div (lt_of_lt_of_le hY0 hle).ne' hY0.ne', Real.log_rpow hY0]\n    calc |C| * ((1 + δ) * Real.log Y - Real.log Y) = |C| * δ * Real.log Y := by ring\n      _ ≤ Y ^ η := hK\n\nend Deduction\n\nend\n","kernel":true}