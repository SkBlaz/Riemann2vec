9,"Formalism.VW.rh_of_right","Mathlib.Data.Complex.Basic","Complex"],[41,19,41,33,"Formalism.VW.rh_of_right","Mathlib.Data.Complex.Basic","Complex.mul_re"],[24,58,24,76,"Formalism.VW.rh_of_right","Mathlib.Data.Complex.Basic","Complex.natCast_re"],[24,42,24,56,"Formalism.VW.rh_of_right","Mathlib.Data.Complex.Basic","Complex.neg_re"],[15,26,15,40,"Formalism.VW.rh_of_right","Mathlib.Data.Complex.Basic","Complex.one_re"],[24,26,24,40,"Formalism.VW.rh_of_right","Mathlib.Data.Complex.Basic","Complex.one_re"],[4,58,4,60,"Formalism.VW.rh_of_right","Mathlib.Data.Complex.Basic","Complex.re"],[7,25,7,27,"Formalism.VW.rh_of_right","Mathlib.Data.Complex.Basic","Complex.re"],[14,30,14,32,"Formalism.VW.rh_of_right","Mathlib.Data.Complex.Basic","Complex.re"],[23,26,23,36,"Formalism.VW.rh_of_right","Mathlib.Data.Complex.Basic","Complex.re"],[40,21,40,23,"Formalism.VW.rh_of_right","Mathlib.Data.Complex.Basic","Complex.re"],[15,10,15,24,"Formalism.VW.rh_of_right","Mathlib.Data.Complex.Basic","Complex.sub_re"],[24,10,24,24,"Formalism.VW.rh_of_right","Mathlib.Data.Complex.Basic","Complex.sub_re"],[25,30,25,41,"Formalism.VW.rh_of_right","Mathlib.Data.Nat.Cast.Order.Ring","Nat.cast_nonneg"],[25,18,25,19,"Formalism.VW.rh_of_right","Mathlib.Data.Real.Basic","Real"],[40,36,40,37,"Formalism.VW.rh_of_right","Mathlib.Data.Real.Basic","Real"],[44,22,44,23,"Formalism.VW.rh_of_right","Mathlib.Data.Real.Basic","Real"],[4,92,4,109,"Formalism.VW.rh_of_right","Mathlib.NumberTheory.LSeries.RiemannZeta","RiemannHypothesis"],[5,9,5,26,"Formalism.VW.rh_of_right","Mathlib.NumberTheory.LSeries.RiemannZeta","RiemannHypothesis"],[4,71,4,82,"Formalism.VW.rh_of_right","Mathlib.NumberTheory.LSeries.RiemannZeta","riemannZeta"],[27,16,27,35,"Formalism.VW.rh_of_right","Mathlib.NumberTheory.LSeries.RiemannZeta","riemannZeta_one_sub"],[12,10,12,26,"Formalism.VW.rh_of_right","Mathlib.NumberTheory.LSeries.RiemannZeta","riemannZeta_zero"],[7,9,7,22,"Formalism.VW.rh_of_right","Mathlib.Order.Defs.LinearOrder","lt_trichotomy"],[43,15,43,28,"Formalism.VW.rh_of_right","Mathlib.Order.Defs.LinearOrder","lt_trichotomy"]],"source":"import Mathlib\n\nopen Complex\n\ntheorem Formalism.VW.rh_of_right (hz : ∀ s : ℂ, 1 / 2 < s.re → s ≠ 1 → riemannZeta s ≠ 0) : RiemannHypothesis := by\n  unfold RiemannHypothesis\n  intro s hs htriv hs1\n  rcases lt_trichotomy s.re (1 / 2) with hlt | heq | hgt\n  · exfalso\n    have hpi : (Real.pi : ℂ) ≠ 0 := by exact_mod_cast Real.pi_ne_zero\n    have hs0 : s ≠ 0 := by\n      rintro rfl\n      rw [riemannZeta_zero] at hs\n      norm_num at hs\n    have ht : 1 / 2 < (1 - s).re := by\n      rw [Complex.sub_re, Complex.one_re]\n      linarith\n    have h1 : (1 - s) ≠ 1 := by\n      intro h\n      apply hs0\n      linear_combination -h\n    have hnat : ∀ n : ℕ, (1 - s) ≠ -(n : ℂ) := by\n      intro n h\n      have hr := congrArg Complex.re h\n      rw [Complex.sub_re, Complex.one_re, Complex.neg_re, Complex.natCast_re] at hr\n      have : (0 : ℝ) ≤ n := n.cast_nonneg\n      linarith\n    have key := riemannZeta_one_sub hnat h1\n    rw [sub_sub_cancel, hs] at key\n    have hz' := hz (1 - s) ht h1\n    have h2pi : (2 : ℂ) * (2 * (Real.pi : ℂ)) ^ (-(1 - s)) ≠ 0 :=\n      mul_ne_zero two_ne_zero (Complex.cpow_ne_zero_iff.2 (Or.inl (mul_ne_zero two_ne_zero hpi)))\n    have hG : Complex.Gamma (1 - s) ≠ 0 := Complex.Gamma_ne_zero_of_re_pos (by linarith)\n    have hcos : Complex.cos ((Real.pi : ℂ) * (1 - s) / 2) ≠ 0 := by\n      rw [Ne, Complex.cos_eq_zero_iff]\n      rintro ⟨k, hk⟩\n      have h3 : ((1 - s) - (2 * (k : ℂ) + 1)) * (Real.pi : ℂ) = 0 := by\n        linear_combination 2 * hk\n      rcases mul_eq_zero.1 h3 with h | h\n      · have hsk : s = -2 * (k : ℂ) := by linear_combination -h\n        have hre : s.re = -2 * (k : ℝ) := by\n          rw [hsk, Complex.mul_re]\n          simp\n        rcases lt_trichotomy k 0 with hk0 | hk0 | hk0\n        · have : (k : ℝ) ≤ -1 := by exact_mod_cast (show k ≤ -1 by omega)\n          linarith\n        · apply hs0\n          rw [hsk, hk0]\n          simp\n        · apply htriv\n          refine ⟨(k - 1).toNat, ?_⟩\n          have hnk : ((k - 1).toNat : ℤ) = k - 1 := Int.toNat_of_nonneg (by omega)\n          have h' : (((k - 1).toNat : ℕ) : ℂ) = (k : ℂ) - 1 := by\n            have := congrArg (fun m : ℤ => (m : ℂ)) hnk\n            push_cast at this\n            exact this\n          rw [hsk, h']\n          ring\n      · exact hpi h\n    exact (mul_ne_zero (mul_ne_zero (mul_ne_zero h2pi hG) hcos) hz') key.symm\n  · exact heq\n  · exact absurd hs (hz s hgt hs1)\n","kernel":true}