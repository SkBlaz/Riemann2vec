{"module":"Development.AutomorphicArithmetic.CharacterBoxes.HalfPlane","decls":{"Claim.HalfPlane":[2,0,3,130,2,4,2,19],"Claim.Strip":[5,0,6,134,5,4,5,15],"Claim.Zeta":[8,0,9,83,8,4,8,14]},"refs":[[3,13,3,19,"Claim.HalfPlane","Init.Data.NeZero","NeZero"],[6,13,6,19,"Claim.Strip","Init.Data.NeZero","NeZero"],[3,9,3,10,"Claim.HalfPlane","Init.Prelude","Nat"],[6,9,6,10,"Claim.Strip","Init.Prelude","Nat"],[9,40,9,41,"Claim.Zeta","Init.Prelude","Nat"],[3,47,3,48,"Claim.HalfPlane","Mathlib.Data.Complex.Basic","Complex"],[3,57,3,58,"Claim.HalfPlane","Mathlib.Data.Complex.Basic","Complex"],[6,47,6,48,"Claim.Strip","Mathlib.Data.Complex.Basic","Complex"],[6,57,6,58,"Claim.Strip","Mathlib.Data.Complex.Basic","Complex"],[9,8,9,9,"Claim.Zeta","Mathlib.Data.Complex.Basic","Complex"],[3,71,3,73,"Claim.HalfPlane","Mathlib.Data.Complex.Basic","Complex.re"],[6,67,6,69,"Claim.Strip","Mathlib.Data.Complex.Basic","Complex.re"],[6,74,6,76,"Claim.Strip","Mathlib.Data.Complex.Basic","Complex.re"],[6,124,6,126,"Claim.Strip","Mathlib.Data.Complex.Basic","Complex.re"],[9,73,9,75,"Claim.Zeta","Mathlib.Data.Complex.Basic","Complex.re"],[3,28,3,46,"Claim.HalfPlane","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter"],[6,28,6,46,"Claim.Strip","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter"],[3,94,3,122,"Claim.HalfPlane","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction"],[6,83,6,111,"Claim.Strip","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction"],[9,11,9,22,"Claim.Zeta","Mathlib.NumberTheory.LSeries.RiemannZeta","riemannZeta"]],"source":"import Mathlib\n\ndef Claim.HalfPlane : Prop :=\n  ∀ (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N) (s : ℂ), 1 / 2 < s.re → (χ ≠ 1 ∨ s ≠ 1) → DirichletCharacter.LFunction χ s ≠ 0\n\ndef Claim.Strip : Prop :=\n  ∀ (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N) (s : ℂ), 0 < s.re → s.re < 1 → DirichletCharacter.LFunction χ s = 0 → s.re = 1 / 2\n\ndef Claim.Zeta : Prop :=\n  ∀ s : ℂ, riemannZeta s = 0 → (¬ ∃ n : ℕ, s = -2 * (n + 1)) → s ≠ 1 → s.re = 1 / 2\n","kernel":true}