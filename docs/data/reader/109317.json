NumberTheory.DirichletCharacter.Basic","DirichletCharacter.conductor_dvd_level"],[9,43,9,61,"UpperTheory.Top.imprimitive","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.primitiveCharacter"],[10,15,10,33,"UpperTheory.Top.imprimitive","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.primitiveCharacter"],[17,79,17,97,"UpperTheory.Top.imprimitive","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.primitiveCharacter"],[23,15,23,33,"UpperTheory.Top.imprimitive","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.primitiveCharacter"],[24,15,24,33,"UpperTheory.Top.imprimitive","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.primitiveCharacter"],[28,15,28,33,"UpperTheory.Top.imprimitive","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.primitiveCharacter"],[30,12,30,30,"UpperTheory.Top.imprimitive","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.primitiveCharacter"],[24,65,24,95,"UpperTheory.Top.imprimitive","Mathlib.NumberTheory.DirichletCharacter.Bounds","DirichletCharacter.norm_le_one"],[6,6,6,34,"UpperTheory.Top.imprimitive","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction"],[9,12,9,40,"UpperTheory.Top.imprimitive","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction"],[17,14,17,54,"UpperTheory.Top.imprimitive","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction_changeLevel"],[34,8,34,17,"UpperTheory.Top.imprimitive","Mathlib.Order.Defs.PartialOrder","lt_irrefl"]],"source":"import Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.ExplicitFormulaErrorOfHostConditions\n\nopen Formalism.HC\n\ntheorem UpperTheory.Top.imprimitive :\n    ZeroFreeAll → ∀ (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N) (s : ℂ), 1 / 2 < s.re → (χ ≠ 1 ∨ s ≠ 1) →\n      DirichletCharacter.LFunction χ s ≠ 0 := by\n  intro h N _ χ s hs hχs\n  haveI : NeZero χ.conductor := (PChar.of χ).ne\n  have hL : DirichletCharacter.LFunction χ.primitiveCharacter s ≠ 0 := h (PChar.of χ) trivial s hs\n  have hχ' : χ.primitiveCharacter ≠ 1 ∨ s ≠ 1 := by\n    rcases hχs with hχ | hs1\n    · left\n      intro h1\n      apply hχ\n      rw [← χ.changeLevel_primitiveCharacter, h1, DirichletCharacter.changeLevel_one]\n    · exact Or.inr hs1\n  have hrw := DirichletCharacter.LFunction_changeLevel χ.conductor_dvd_level χ.primitiveCharacter hχ'\n  rw [χ.changeLevel_primitiveCharacter] at hrw\n  rw [hrw]\n  refine mul_ne_zero hL (Finset.prod_ne_zero_iff.mpr fun p hp => ?_)\n  have hp' := Nat.prime_of_mem_primeFactors hp\n  intro h0\n  have key : χ.primitiveCharacter p * (p : ℂ) ^ (-s) = 1 := by linear_combination -h0\n  have h1 : ‖χ.primitiveCharacter (p : ZMod χ.conductor)‖ ≤ 1 := DirichletCharacter.norm_le_one _ _\n  have h2 : ‖(p : ℂ) ^ (-s)‖ < 1 := by\n    rw [Complex.norm_natCast_cpow_of_pos hp'.pos, Complex.neg_re]\n    exact Real.rpow_lt_one_of_one_lt_of_neg (by exact_mod_cast hp'.one_lt) (by linarith)\n  have hn : ‖χ.primitiveCharacter p * (p : ℂ) ^ (-s)‖ < 1 := by\n    rw [norm_mul]\n    calc ‖χ.primitiveCharacter (p : ZMod χ.conductor)‖ * ‖(p : ℂ) ^ (-s)‖\n        ≤ 1 * ‖(p : ℂ) ^ (-s)‖ := by gcongr\n      _ < 1 := by simpa using h2\n  rw [key, norm_one] at hn\n  exact lt_irrefl _ hn\n","kernel":true}