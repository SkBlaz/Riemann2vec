pe.b","Mathlib.Data.Real.Basic","Real"],[75,12,75,13,"Formalism.HC.HType.X'","Mathlib.Data.Real.Basic","Real"],[75,17,75,18,"Formalism.HC.HType.X'","Mathlib.Data.Real.Basic","Real"],[77,19,77,20,"Formalism.HC.HType.InRange","Mathlib.Data.Real.Basic","Real"],[78,20,78,21,"Formalism.HC.HType.InRange","Mathlib.Data.Real.Basic","Real"],[79,35,79,36,"Formalism.HC.HType.InRange","Mathlib.Data.Real.Basic","Real"],[79,49,79,50,"Formalism.HC.HType.InRange","Mathlib.Data.Real.Basic","Real"],[89,6,89,7,"Formalism.HC.HConst","Mathlib.Data.Real.Basic","Real"],[92,6,92,7,"Formalism.HC.HConst","Mathlib.Data.Real.Basic","Real"],[105,29,105,30,"Formalism.HC.HostRaw.OddPrimesSplitBelow","Mathlib.Data.Real.Basic","Real"],[106,43,106,44,"Formalism.HC.HostRaw.OddPrimesSplitBelow","Mathlib.Data.Real.Basic","Real"],[108,46,108,47,"Formalism.HC.HostRaw.SmallPrimeSizeBounds","Mathlib.Data.Real.Basic","Real"],[108,88,108,89,"Formalism.HC.HostRaw.SmallPrimeSizeBounds","Mathlib.Data.Real.Basic","Real"],[110,37,110,38,"Formalism.HC.HostRaw.DiscriminantConductorSizes","Mathlib.Data.Real.Basic","Real"],[111,66,111,67,"Formalism.HC.HostRaw.DiscriminantConductorSizes","Mathlib.Data.Real.Basic","Real"],[113,27,113,28,"Formalism.HC.HostRaw.ModulusSizeBounds","Mathlib.Data.Real.Basic","Real"],[115,32,115,33,"Formalism.HC.HostRaw.PrimePairSizeCondition","Mathlib.Data.Real.Basic","Real"],[116,100,116,101,"Formalism.HC.HostRaw.PrimePairSizeCondition","Mathlib.Data.Real.Basic","Real"],[120,50,120,51,"Formalism.HC.PreHost","Mathlib.Data.Real.Basic","Real"],[16,44,16,48,"Formalism.HC.PChar.val","Mathlib.Data.ZMod.Defs","ZMod"],[34,39,34,43,"Formalism.HC.PChar.IsReal","Mathlib.Data.ZMod.Defs","ZMod"],[9,6,9,24,"Formalism.HC.PChar","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter"],[31,31,31,49,"Formalism.HC.PChar.of","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter"],[10,11,10,22,"Formalism.HC.PChar","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.IsPrimitive"],[44,48,44,51,"Formalism.HC.KSet","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.Odd"],[22,17,22,26,"Formalism.HC.PChar.inv","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.conductor"],[32,14,32,23,"Formalism.HC.PChar.of","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.conductor"],[23,11,23,43,"Formalism.HC.PChar.inv","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.conductor_inv"],[32,27,32,44,"Formalism.HC.PChar.of","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.conductor_ne_zero"],[18,26,18,70,"Formalism.HC.PChar.one","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.isPrimitive_one_level_one"],[32,48,32,66,"Formalism.HC.PChar.of","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.primitiveCharacter"],[32,69,32,99,"Formalism.HC.PChar.of","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter.primitiveCharacter_isPrimitive"],[106,52,106,61,"Formalism.HC.HostRaw.OddPrimesSplitBelow","Mathlib.NumberTheory.LegendreSymbol.JacobiSymbol","jacobiSym"],[103,55,103,58,"Formalism.HC.HostRaw.condN_neZero","Mathlib.Order.Basic","LT.lt.ne'"]],"source":"import Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.ConjEMemHostFIff\n\nnoncomputable section\n\nnamespace Formalism.HC\n\nstructure PChar where\n  N : ℕ\n  [ne : NeZero N]\n  χ : DirichletCharacter ℂ N\n  prim : χ.IsPrimitive\n\nattribute [instance] PChar.ne\n\nnamespace PChar\n\ndef val (ψ : PChar) (a : ℕ) : ℂ := ψ.χ (a : ZMod ψ.N)\n\ndef one : PChar := ⟨1, 1, DirichletCharacter.isPrimitive_one_level_one⟩\n\ndef inv (ψ : PChar) : PChar :=\n  ⟨ψ.N, ψ.χ⁻¹, by\n    have h : ψ.χ.conductor = ψ.N := ψ.prim\n    exact (DirichletCharacter.conductor_inv ψ.χ).trans h⟩\n\ntheorem inv_inv (ψ : PChar) : ψ.inv.inv = ψ := by\n  cases ψ\n  simp only [inv]\n  congr 1\n  exact _root_.inv_inv _\n\ndef of {N : ℕ} [NeZero N] (χ : DirichletCharacter ℂ N) : PChar :=\n  @PChar.mk χ.conductor ⟨χ.conductor_ne_zero⟩ χ.primitiveCharacter χ.primitiveCharacter_isPrimitive\n\ndef IsReal (ψ : PChar) : Prop := ∀ a : ZMod ψ.N, (ψ.χ a).im = 0\n\nend PChar\n\nstructure KSet where\n  KEPT : Finset PChar\n  one_mem : PChar.one ∈ KEPT\n  inv_mem : ∀ ψ ∈ KEPT, ψ.inv ∈ KEPT\n\n  psK : Option PChar\n  psK_spec : ∀ ψ, psK = some ψ → ψ ∈ KEPT ∧ ψ.χ.Odd ∧ ψ.IsReal\n\nstructure HType extends KSet where\n  eps : ℝ\n  eps_pos : 0 < eps\n  eps_lt : eps < 1 / 52\n  J : ℕ\n  one_le_J : 1 ≤ J\n  P0 : ℕ\n  P0_pos : 0 < P0\n\n  t : ℝ → ℕ\n  Ct : ℝ\n  t_le : ∀ x : ℝ, 1 ≤ x → (t x : ℝ) ≤ x ^ Ct\n\nnamespace HType\n\nvariable (T : HType)\n\ndef SM : Finset ℕ := (2 * T.P0 * ∏ ψ ∈ T.KEPT, ψ.N).primeFactors\n\ndef P : ℕ := ∏ p ∈ (∏ l ∈ T.SM, l * (l - 1)).primeFactors.erase 2, p\n\ndef z (X : ℝ) : ℝ := X ^ (T.eps / (5 * (T.J : ℝ)))\n\ndef z' (X : ℝ) : ℝ := T.z X * Real.log (X ^ ((1 : ℝ) / T.J)) ^ 2\n\ndef L (x : ℝ) : ℝ := x ^ T.eps\n\ndef b (x : ℝ) : ℝ := Real.exp (T.L x)\n\ndef X' (x : ℝ) : ℝ := Real.exp (x ^ (T.eps / 3))\n\ndef InRange (X x : ℝ) (e : ℕ) : Prop :=\n  1 ≤ X ∧ X ^ ((1 : ℝ) / T.J) ≤ x ∧ x ≤ X ∧\n    x ^ (2 + 8 * T.eps) / 2 ≤ (2 : ℝ) ^ e ∧ (2 : ℝ) ^ e ≤ 2 * x ^ (2 + 8 * T.eps)\n\nend HType\n\nstructure HConst where\n\n  oB : ℕ\n\n  rB : ℕ\n\n  c : ℝ\n  c_pos : 0 < c\n\n  C : ℝ\n\ndef Frame.TorsionIndexBounded (φ : Frame) (oB : ℕ) : Prop := φ.o ≤ oB\n\nnamespace HostRaw\n\nvariable {φ : Frame} (H : HostRaw φ)\n\ntheorem condN_pos : 0 < H.condN :=\n  Nat.mul_pos (Nat.mul_pos H.QS_pos H.hyp.1.pos) H.hyp.2.1.pos\n\ninstance condN_neZero : NeZero H.condN := ⟨H.condN_pos.ne'⟩\n\ndef OddPrimesSplitBelow (z : ℝ) : Prop :=\n  11 ≤ z ∧ ∀ p : ℕ, p.Prime → p ≠ 2 → (p : ℝ) ≤ z → jacobiSym (-(H.d : ℤ)) p = 1\n\ndef SmallPrimeSizeBounds (SM : Finset ℕ) (z : ℝ) : Prop := ∀ l ∈ H.small, l ∈ SM ∧ (l : ℝ) ≤ z / 4\n\ndef DiscriminantConductorSizes (z' : ℝ) : Prop :=\n  z' / 2 < Real.log H.d ∧ Real.log H.d ≤ z' ∧ Real.log (H.condN : ℝ) ≤ 3 * z'\n\ndef ModulusSizeBounds (z : ℝ) : Prop := z / 2 < Real.log H.q ∧ Real.log H.q ≤ z\n\ndef PrimePairSizeCondition (z : ℝ) (rB rr rr' : ℕ) : Prop :=\n  rr.Prime ∧ rr'.Prime ∧ rr ≠ 2 ∧ rr < rr' ∧ rr' < 2 * rr ∧ Nat.Coprime (rr * rr') H.condN ∧ (rr' : ℝ) ≤ z ∧ rr' ≤ rB\n\nend HostRaw\n\nstructure PreHost (T : HType) (κ : HConst) (X x : ℝ) {φ : Frame} (H : HostAx φ) (rr rr' : ℕ) : Prop where\n  range : T.InRange X x φ.e\n  ha5 : φ.TorsionIndexBounded κ.oB\n  ha6 : H.OddPrimesSplitBelow (T.z X)\n  ha7 : H.SmallPrimeSizeBounds T.SM (T.z X)\n  ha8 : H.DiscriminantConductorSizes (T.z' X)\n  ha9 : H.ModulusSizeBounds (T.z X)\n  ha12 : H.PrimePairSizeCondition (T.z X) κ.rB rr rr'\n\nend Formalism.HC\n\nend\n","kernel":true}