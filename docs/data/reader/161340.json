Avg","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction"],[49,38,49,66,"Formalism.OCAvg","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction"],[56,43,56,71,"Formalism.OCAvgUpper","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction"],[60,27,60,55,"Formalism.OCAvgUpper","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction"],[62,38,62,66,"Formalism.OCAvgUpper","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction"],[69,32,69,60,"Formalism.RiemannHypothesisOfLowerBounds","Mathlib.NumberTheory.LSeries.DirichletContinuation","DirichletCharacter.LFunction"],[70,2,70,19,"Formalism.RiemannHypothesisOfLowerBounds","Mathlib.NumberTheory.LSeries.RiemannZeta","RiemannHypothesis"],[28,20,28,31,"Formalism.OCStep","Mathlib.NumberTheory.LSeries.RiemannZeta","riemannZeta"],[36,20,36,31,"Formalism.OCStepUpper","Mathlib.NumberTheory.LSeries.RiemannZeta","riemannZeta"],[46,20,46,31,"Formalism.OCAvg","Mathlib.NumberTheory.LSeries.RiemannZeta","riemannZeta"],[48,37,48,48,"Formalism.OCAvg","Mathlib.NumberTheory.LSeries.RiemannZeta","riemannZeta"],[59,20,59,31,"Formalism.OCAvgUpper","Mathlib.NumberTheory.LSeries.RiemannZeta","riemannZeta"],[61,37,61,48,"Formalism.OCAvgUpper","Mathlib.NumberTheory.LSeries.RiemannZeta","riemannZeta"],[10,28,10,38,"Formalism.Sz","Mathlib.Order.Interval.Finset.Defs","Finset.Icc"],[17,8,17,18,"Formalism.Schi","Mathlib.Order.Interval.Finset.Defs","Finset.Icc"]],"source":"import Formalism.Statement\n\nopen Complex MeasureTheory Set Filter Topology\n\nnoncomputable section\n\nnamespace Formalism\n\nopen ArithmeticFunction in\n\ndef Sz (x : ℝ) : ℝ := ∑ n ∈ Finset.Icc 1 ⌊x⌋₊, Λ n * (x / n - 1)\n\ndef Gz (x : ℝ) : ℝ := Sz x - x * Real.log x + (1 + Real.eulerMascheroniConstant) * x\n\nopen ArithmeticFunction in\n\ndef Schi {N : ℕ} (χ : DirichletCharacter ℂ N) (x : ℝ) : ℝ :=\n  ∑ n ∈ Finset.Icc 1 ⌊x⌋₊, Λ n * (χ n).re * (x / n - 1)\n\ndef Gchi {N : ℕ} [NeZero N] (χ : DirichletCharacter ℂ N) (x : ℝ) : ℝ :=\n  Schi χ x + (deriv (DirichletCharacter.LFunction χ) 1 / DirichletCharacter.LFunction χ 1).re * x\n\ndef OCStep : Prop :=\n  ∀ (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N), χ ≠ 1 → (∀ n : ℕ, (χ n).im = 0) →\n  ∀ θ : ℝ, 0 < θ → θ < 1 →\n  (∃ C : ℝ, ∀ x : ℝ, 1 ≤ x → -C * x ^ θ ≤ Gz x - Gchi χ x) →\n  (∀ σ : ℝ, θ < σ → σ < 1 → DirichletCharacter.LFunction χ σ ≠ 0) ∧\n  ∀ s : ℂ, θ < s.re → s ≠ 1 →\n    analyticOrderAt riemannZeta s = analyticOrderAt (DirichletCharacter.LFunction χ) s\n\ndef OCStepUpper : Prop :=\n  ∀ (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N), χ ≠ 1 → (∀ n : ℕ, (χ n).im = 0) →\n  ∀ θ : ℝ, 0 < θ → θ < 1 →\n  (∀ σ : ℝ, θ < σ → σ < 1 → DirichletCharacter.LFunction χ σ ≠ 0) →\n  (∃ C : ℝ, ∀ x : ℝ, 1 ≤ x → Gz x - Gchi χ x ≤ C * x ^ θ) →\n  ∀ s : ℂ, θ < s.re → s ≠ 1 →\n    analyticOrderAt riemannZeta s = analyticOrderAt (DirichletCharacter.LFunction χ) s\n\ndef OCAvg : Prop :=\n  ∀ (ι : Type) [Fintype ι] (N : ι → ℕ) [∀ i, NeZero (N i)]\n    (χ : (i : ι) → DirichletCharacter ℂ (N i)) (w : ι → ℝ),\n  (∀ i, χ i ≠ 1) → (∀ i (n : ℕ), (χ i n).im = 0) → (∀ i, 0 ≤ w i) → 0 < ∑ i, w i →\n  ∀ θ : ℝ, 0 < θ → θ < 1 →\n  (∃ C : ℝ, ∀ x : ℝ, 1 ≤ x → -C * x ^ θ ≤ ∑ i, w i * (Gz x - Gchi (χ i) x)) →\n  (∀ i, 0 < w i → ∀ σ : ℝ, θ < σ → σ < 1 → DirichletCharacter.LFunction (χ i) σ ≠ 0) ∧\n  ∀ s : ℂ, θ < s.re → s ≠ 1 →\n    analyticOrderAt riemannZeta s ≠ ⊤ ∧\n    (∀ i, analyticOrderAt (DirichletCharacter.LFunction (χ i)) s ≠ ⊤) ∧\n    (∑ i, w i) * (analyticOrderNatAt riemannZeta s : ℝ) =\n      ∑ i, w i * (analyticOrderNatAt (DirichletCharacter.LFunction (χ i)) s : ℝ)\n\ndef OCAvgUpper : Prop :=\n  ∀ (ι : Type) [Fintype ι] (N : ι → ℕ) [∀ i, NeZero (N i)]\n    (χ : (i : ι) → DirichletCharacter ℂ (N i)) (w : ι → ℝ),\n  (∀ i, χ i ≠ 1) → (∀ i (n : ℕ), (χ i n).im = 0) → (∀ i, 0 ≤ w i) → 0 < ∑ i, w i →\n  ∀ θ : ℝ, 0 < θ → θ < 1 →\n  (∀ i, 0 < w i → ∀ σ : ℝ, θ < σ → σ < 1 → DirichletCharacter.LFunction (χ i) σ ≠ 0) →\n  (∃ C : ℝ, ∀ x : ℝ, 1 ≤ x → ∑ i, w i * (Gz x - Gchi (χ i) x) ≤ C * x ^ θ) →\n  ∀ s : ℂ, θ < s.re → s ≠ 1 →\n    analyticOrderAt riemannZeta s ≠ ⊤ ∧\n    (∀ i, analyticOrderAt (DirichletCharacter.LFunction (χ i)) s ≠ ⊤) ∧\n    (∑ i, w i) * (analyticOrderNatAt riemannZeta s : ℝ) =\n      ∑ i, w i * (analyticOrderNatAt (DirichletCharacter.LFunction (χ i)) s : ℝ)\n\ndef RiemannHypothesisOfLowerBounds : Prop :=\n  ∀ (ι : Type) (N : ι → ℕ) [∀ i, NeZero (N i)] (χ : (i : ι) → DirichletCharacter ℂ (N i)),\n  (∀ i, χ i ≠ 1) → (∀ i (n : ℕ), (χ i n).im = 0) →\n  (∀ i, ∀ ε : ℝ, 0 < ε → ∃ C : ℝ, ∀ x : ℝ, 1 ≤ x →\n      -C * x ^ ((1 : ℝ) / 2 + ε) ≤ Gz x - Gchi (χ i) x) →\n  (∀ s : ℂ, 1 / 2 < s.re → ∃ i, DirichletCharacter.LFunction (χ i) s ≠ 0) →\n  RiemannHypothesis\n\nend Formalism\n","kernel":true}