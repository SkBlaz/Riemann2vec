thlib.Data.Real.Basic","Real"],[20,56,20,57,"","Mathlib.Data.Real.Basic","Real"],[23,17,23,18,"Formalism.HC.ChebyshevInequalityForFamily","Mathlib.Data.Real.Basic","Real"],[24,24,24,25,"Formalism.HC.ChebyshevInequalityForFamily","Mathlib.Data.Real.Basic","Real"],[25,11,25,12,"Formalism.HC.ChebyshevInequalityForFamily","Mathlib.Data.Real.Basic","Real"],[25,43,25,44,"Formalism.HC.ChebyshevInequalityForFamily","Mathlib.Data.Real.Basic","Real"],[28,15,28,16,"Formalism.HC.ChebyshevInequalityEventual","Mathlib.Data.Real.Basic","Real"],[28,35,28,36,"Formalism.HC.ChebyshevInequalityEventual","Mathlib.Data.Real.Basic","Real"],[29,23,29,24,"Formalism.HC.ChebyshevInequalityEventual","Mathlib.Data.Real.Basic","Real"],[10,59,10,77,"Formalism.HC.An.logDerivative_at_one_eq","Mathlib.NumberTheory.DirichletCharacter.Basic","DirichletCharacter"]],"source":"import Formalism.SharpRestriction.FamCore\nimport Formalism.SharpRestriction.GlobalSchurBounds.GeneralLinearActions.FiltrationCocycleLiftCriterion\nimport Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.Landau\n\nnoncomputable section\n\nopen Formalism.BasicNotions Formalism.MainNotions\n\nnamespace Formalism.HC\n\ntheorem An.logDerivative_at_one_eq {N : ℕ} [NeZero N] (χ : DirichletCharacter ℂ N) : An.logDerivativeAtOne χ = GlobalTheoryTheory.logDerivativeAtOne χ := rfl\n\ndef EAt (Λ : Level) (D : D7) (x eps C : ℝ) : Prop := EAtH Λ D.host.toHostRaw D.host.TT x eps C\n\ndef EFamC (Λ : Level) {eps : ℝ} (Fm : FamCore eps) : Prop :=\n  ∃ C x0 : ℝ, ∀ x ≥ x0, ∀ i : Fm.Ix x, EAt Λ (Fm.D x i) x eps C\n\nsection\n\nvariable {Fam : ℝ → Type 1} (core : ∀ {eps : ℝ}, Fam eps → FamCore eps)\n  (Tied : ∀ {eps : ℝ}, Fam eps → (eD eL K cHH eK CL x : ℝ) → Prop)\n\ndef ChebyshevInequalityForFamily (Λ : Level) : Prop :=\n  ∀ (eD eL eps : ℝ), 0 < eps → ∀ Fm : Fam eps, EFamC Λ (core Fm) →\n    (∃ K cHH eK CL x0 : ℝ, ∀ x ≥ x0, Tied Fm eD eL K cHH eK CL x) →\n    ∃ x1 : ℝ, ∀ x ≥ x1, Λ.Gm x ≤ x ^ ((1 : ℝ) / 2 + (eD + eL + 7) * eps)\n\ndef ChebyshevInequalityEventual (Λ : Level) : Prop :=\n  ∃ eD eL ε₁ : ℝ, 0 < ε₁ ∧ ∀ eps : ℝ, 0 < eps → eps < ε₁ → ∃ Fm : Fam eps, EFamC Λ (core Fm) ∧\n    ∃ K cHH eK CL x0 : ℝ, ∀ x ≥ x0, Tied Fm eD eL K cHH eK CL x\n\nvariable {core Tied}\n\nend\n\nend Formalism.HC\n\nend\n","kernel":true}